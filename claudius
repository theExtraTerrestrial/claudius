#!/usr/bin/env bash
# NOTE: `set -euo pipefail` and the EXIT trap are deliberately NOT set at the top
# level — they are enabled inside main() instead. When this script is *sourced*
# (e.g. `. ~/claude-account-switch.sh`), top-level shell-option changes and traps
# would leak into the caller's interactive shell, and a later `exit` would kill it.
# See the sourced-safe launcher at the bottom of the file.

PROFILE_ROOT="${HOME}/.claude-profiles"
ACTIVE_PROFILE_FILE="${PROFILE_ROOT}/.active_profile"
CLAUDE_DIR="${HOME}/.claude"
CLAUDE_CONFIG="${HOME}/.claude.json"
# macOS stores the Claude Code OAuth credential in the login Keychain under this
# service name (account = the macOS user), not in a .credentials.json file.
KEYCHAIN_SERVICE="Claude Code-credentials"
# Oldest CLI release in which the Keychain credential item is namespaced per config
# dir (see keychain_service_for_dir), which is what lets `run` isolate an account on
# macOS. 2.1.220 is the version this was read out of and reasoned about; below it,
# `run` falls back to refusing a non-live profile rather than risking a session that
# silently authenticates as the wrong account.
RUN_ISOLATION_MIN_VERSION="2.1.220"
# Claude Code's public OAuth token endpoint + client id, used to refresh a stored
# profile's token directly (see oauth_refresh_creds). These mirror the CLI's own
# values; if Anthropic ever rotates them a refresh simply 401s and degrades to
# "sign in again", so a drift here is graceful, not fatal.
OAUTH_TOKEN_URL="https://platform.claude.com/v1/oauth/token"
OAUTH_CLIENT_ID="9d1c250a-e61b-44d9-88ed-5944d1962f5e"
RAW_MODE_ENABLED=false
ALT_SCREEN_ACTIVE=false

# Fractional `read -t` timeouts need bash >= 4. Apple ships bash 3.2, whose `read`
# only accepts an INTEGER timeout ("invalid timeout specification" otherwise). Fall
# back to 1s there: a lone ESC waits up to 1s, but arrow-key escape sequences arrive
# as a burst already sitting in the tty buffer, so they still read instantly.
if (( BASH_VERSINFO[0] >= 4 )); then ESC_SEQ_TIMEOUT=0.05; else ESC_SEQ_TIMEOUT=1; fi

# Marker glyphs (single-column unicode — safe on any modern terminal).
GLYPH_ACTIVE='●'
GLYPH_POINTER='➜'
GLYPH_DOT='·'

# Parallel arrays describing the profiles shown in the menu. Populated ONCE per
# menu session by build_profile_meta so rendering never shells out per keypress.
PROFILES=()
P_EMAIL=()
P_ORG=()
P_SUB=()
P_U5=()   # cached 5h utilization %  (empty = none)
P_U7=()   # cached 7d utilization %
P_UTS=()  # epoch the cache was written

cleanup() {
  disable_raw_mode
  leave_alt_screen
}

# ── Terminal primitives ─────────────────────────────────────────────────────
hide_cursor() { printf '\033[?25l'; }
show_cursor() { printf '\033[?25h'; }
enter_alt_screen() {
  printf '\033[?1049h'
  ALT_SCREEN_ACTIVE=true
}

# Idempotent: only the first leave emits the escape. A second `\033[?1049l` after
# we've already switched to the primary buffer and printed there would re-restore
# the cursor to its pre-alt-screen position, stranding our output below the prompt.
leave_alt_screen() {
  [[ "$ALT_SCREEN_ACTIVE" == true ]] || return 0
  show_cursor
  printf '\033[?1049l'
  ALT_SCREEN_ACTIVE=false
}

clear_screen() { printf '\033[2J\033[H'; }

enable_raw_mode() {
  if [[ -t 0 ]] && [[ -r /dev/tty ]]; then
    stty -echo -icanon -icrnl < /dev/tty 2>/dev/null || true
    RAW_MODE_ENABLED=true
  fi
}

disable_raw_mode() {
  if [[ "$RAW_MODE_ENABLED" == true ]]; then
    stty sane < /dev/tty 2>/dev/null || true
    RAW_MODE_ENABLED=false
  fi
}

quit_program() {
  disable_raw_mode
  leave_alt_screen
  printf 'Bye.\n'
  exit 0
}

# ── Colour palette (accent-forward, degrades to bold/reverse under NO_COLOR) ──
init_colors() {
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    C_RESET=$'\033[0m'
    C_DIM=$'\033[2m'
    C_BOLD=$'\033[1m'
    C_ACCENT=$'\033[38;5;39m'    # bright blue
    C_TITLE=$'\033[1m\033[38;5;39m'
    C_MUTED=$'\033[38;5;245m'
    C_RULE=$'\033[38;5;238m'
    C_ACTIVE=$'\033[38;5;42m'    # green dot for the live profile
    C_SEL=$'\033[1m\033[38;5;231m\033[48;5;24m'  # bold near-white on dark cyan
    C_GREEN=$'\033[38;5;42m'
    C_AMBER=$'\033[38;5;214m'
    C_RED=$'\033[38;5;203m'
    C_KEY=$'\033[1m\033[38;5;39m'
  else
    C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
    C_ACCENT=''; C_TITLE=$'\033[1m'; C_MUTED=$'\033[2m'; C_RULE=''
    C_ACTIVE=$'\033[1m'; C_SEL=$'\033[7m'
    C_GREEN=''; C_AMBER=''; C_RED=''; C_KEY=$'\033[1m'
  fi
}

# ── Small text helpers (operate on PLAIN text; width math assumes UTF-8) ──────
term_cols() {
  local c
  c="$(tput cols 2>/dev/null || echo 80)"
  [[ "$c" =~ ^[0-9]+$ ]] || c=80
  printf '%s' "$c"
}

# Truncate plain text to at most $1 columns, adding an ellipsis when cut.
trunc() {
  local w="$1" s="$2"
  if (( ${#s} > w )); then
    if (( w >= 1 )); then printf '%s…' "${s:0:w-1}"; fi
  else
    printf '%s' "$s"
  fi
}

# Pad (or truncate) plain text to exactly $1 columns.
pad_to() {
  local w="$1" s
  s="$(trunc "$1" "$2")"
  printf '%s%*s' "$s" $(( w - ${#s} )) ''
}

# Colour for a utilization percentage: low=green, mid=amber, high=red.
sem_color() {
  local p="$1"
  if (( p >= 80 )); then printf '%s' "$C_RED"
  elif (( p >= 50 )); then printf '%s' "$C_AMBER"
  else printf '%s' "$C_GREEN"; fi
}

# A compact filled/empty bar for a percentage.
render_bar() {
  local pct="$1" cells="${2:-4}" col="$3"
  local filled=$(( (pct * cells + 50) / 100 ))
  (( filled > cells )) && filled=cells
  (( filled < 0 )) && filled=0
  local i s=""
  for (( i = 0; i < filled; i++ )); do s+="█"; done
  for (( i = filled; i < cells; i++ )); do s+="░"; done
  printf '%s%s%s' "$col" "$s" "$C_RESET"
}

# Same bar as render_bar but with NO escape sequences — safe to embed in the plain
# row body (which is displayed verbatim, under reverse video, on the selected row).
bar_plain() {
  local pct="$1" cells="${2:-4}"
  local filled=$(( (pct * cells + 50) / 100 ))
  (( filled > cells )) && filled=cells
  (( filled < 0 )) && filled=0
  local i s=""
  for (( i = 0; i < filled; i++ )); do s+="█"; done
  for (( i = filled; i < cells; i++ )); do s+="░"; done
  printf '%s' "$s"
}

fmt_age() {
  local ts="$1" now diff
  now="$(date +%s)"
  diff=$(( now - ts ))
  (( diff < 0 )) && diff=0
  if (( diff < 60 )); then printf 'just now'
  elif (( diff < 3600 )); then printf '%dm ago' $(( diff / 60 ))
  elif (( diff < 86400 )); then printf '%dh ago' $(( diff / 3600 ))
  else printf '%dd ago' $(( diff / 86400 )); fi
}

# Modification time (epoch) of a file, portable across GNU and BSD/macOS `stat`.
# GNU uses `-c %Y`; BSD uses `-f %m`. `-c` errors as an illegal option on BSD, so
# the `||` falls through to `-f`; on GNU `-c` succeeds and `-f` is never reached.
file_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
}

# ── macOS Keychain bridge ─────────────────────────────────────────────────────
# On macOS, `claude auth login` stores the OAuth credential JSON in the login
# Keychain (service "$KEYCHAIN_SERVICE", account = the macOS user), NOT in a
# .credentials.json file — and CLAUDE_CONFIG_DIR does NOT redirect it: every config
# dir shares that one Keychain item. So on macOS we bridge the Keychain by hand:
# capture the token out of it after a login, and push a profile's token back into
# it on activation. On Linux (no `security`) these are no-ops and the plain
# .credentials.json file path is used throughout.
keychain_available() {
  [[ "$(uname 2>/dev/null)" == "Darwin" ]] && command -v security >/dev/null 2>&1
}

keychain_account() { printf '%s' "${USER:-$(id -un 2>/dev/null || echo "")}"; }

# The Keychain SERVICE name Claude Code uses for a given config dir. Since 2.1.x
# the item is namespaced per config dir: with CLAUDE_CONFIG_DIR (or
# CLAUDE_SECURESTORAGE_CONFIG_DIR) set to a non-default dir the service becomes
#   "Claude Code-credentials-<first 8 hex of sha256(dir)>"
# and without it the bare "$KEYCHAIN_SERVICE". This mirrors the CLI's own service
# name builder, so `run` can give each profile its OWN credential item instead of
# every config dir sharing one. Empty/absent arg → the shared default item.
#
# This is undocumented CLI internals, not a published contract: if a future
# release changes the scheme, the namespaced item simply won't be found and Claude
# Code falls back to the profile's own .credentials.json, which is why
# run_profile seeds BOTH. Nonzero (and the default name) if the hash fails.
keychain_service_for_dir() {
  local dir="${1:-}"
  if [[ -z "$dir" ]]; then printf '%s' "$KEYCHAIN_SERVICE"; return 0; fi
  local hash
  hash="$(ruby -rdigest -e 'print Digest::SHA256.hexdigest(ARGV[0].unicode_normalize(:nfc))[0, 8]' "$dir" 2>/dev/null)" || hash=""
  if [[ -z "$hash" ]]; then printf '%s' "$KEYCHAIN_SERVICE"; return 1; fi
  printf '%s-%s' "$KEYCHAIN_SERVICE" "$hash"
}

# Dump a Keychain credential JSON to stdout (nonzero/empty if absent). $1 is the
# service name, defaulting to the shared live item.
read_keychain_creds() {
  keychain_available || return 1
  local svc="${1:-$KEYCHAIN_SERVICE}"
  security find-generic-password -s "$svc" -a "$(keychain_account)" -w 2>/dev/null
}

# Same, but bounded: never blocks longer than $2 tenths of a second (default 30 =
# 3s). Reading an item claudius did not create can raise a GUI "security wants to
# use your confidential information" prompt, which would hang a non-interactive
# caller forever. Background callers treat failure as "no newer credential
# available" and carry on; interactive ones (see cmd_add) pass a longer budget so
# there is time to actually answer the prompt.
read_keychain_creds_guarded() {
  keychain_available || return 1
  local svc="${1:-$KEYCHAIN_SERVICE}" limit="${2:-30}" out pid waited=0
  out="$(mktemp "${TMPDIR:-/tmp}/claudius.kc.XXXXXX")" || return 1
  security find-generic-password -s "$svc" -a "$(keychain_account)" -w >"$out" 2>/dev/null &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && (( waited < limit )); do
    sleep 0.1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    rm -f "$out"
    return 1
  fi
  wait "$pid" 2>/dev/null || true
  local json; json="$(cat "$out" 2>/dev/null)"
  rm -f "$out"
  [[ -n "$json" ]] || return 1
  printf '%s' "$json"
}

# Replace a Keychain credential with the JSON in file $1 (-U updates the existing
# item in place). $2 is the service name, defaulting to the shared live item.
# Passing -w on the command line is the only scriptable form `security` offers;
# the value is briefly visible to `ps`, an acceptable tradeoff for a local tool.
# Nonzero if the Keychain is unavailable or write fails.
write_keychain_creds() {
  local src="$1" svc="${2:-$KEYCHAIN_SERVICE}" json
  keychain_available || return 1
  [[ -f "$src" ]] || return 1
  json="$(cat "$src" 2>/dev/null)" || return 1
  [[ -n "$json" ]] || return 1
  security add-generic-password -U \
    -s "$svc" -a "$(keychain_account)" -w "$json" >/dev/null 2>&1
}

# The email of the account currently LIVE in the shared macOS Keychain session.
# This — not claudius's .active_profile marker — is what determines whose token a
# refresh would rotate. Prefer `claude auth status` (authoritative for the live
# token), fall back to the ~/.claude.json identity snapshot. Empty if unknown.
live_account_email() {
  keychain_available || return 0
  local email=""
  local st; st="$(claude auth status 2>/dev/null || true)"
  if [[ -n "$st" ]]; then
    email="$(printf '%s' "$st" | ruby -rjson -e 'begin; d=JSON.parse(STDIN.read); rescue; exit 0; end; puts(d["email"]||d["user"]||"")' 2>/dev/null)"
  fi
  if [[ -z "$email" && -f "$CLAUDE_CONFIG" ]]; then
    email="$(ruby -rjson -e 'begin; d=JSON.parse(File.read(ARGV[0])); rescue; exit 0; end; puts((d["oauthAccount"]||{})["emailAddress"]||"")' "$CLAUDE_CONFIG" 2>/dev/null)"
  fi
  printf '%s' "$email"
}

# The email a stored profile is bound to (from its identity file). Empty if unknown.
profile_account_email() {
  local idf; idf="$(profile_identity_path "$PROFILE_ROOT/$1")"
  [[ -f "$idf" ]] || return 0
  ruby -rjson -e 'begin; d=JSON.parse(File.read(ARGV[0])); rescue; exit 0; end; puts((d["oauthAccount"]||{})["emailAddress"]||"")' "$idf" 2>/dev/null
}

# After an isolated `claude auth login`, guarantee the profile dir has a
# .credentials.json. On macOS the freshly minted token lives only in the Keychain,
# so pull it out and write it into the profile (0600). No-op when the file already
# exists (Linux) or the Keychain has nothing.
#
# WHICH Keychain item matters, and getting it wrong is silent. The login ran under
# CLAUDE_CONFIG_DIR=$dir, so on a namespacing CLI the new account's token is in THAT
# dir's item (keychain_service_for_dir) — the shared item still holds the LIVE
# account. Reading the shared item first would therefore capture the wrong account
# and hand the new profile a copy of the live credential, which `credentials_ready`
# cannot detect because it only checks that SOME accessToken is present. Older CLIs
# only ever wrote the one shared item, so fall back to it there and only there.
materialize_profile_credentials() {
  local dir="$1" creds json svc
  creds="$dir/.credentials.json"
  [[ -f "$creds" ]] && return 0
  keychain_available || return 1
  svc="$(keychain_service_for_dir "$dir")"
  # 30s budget: `add` is interactive, so a Keychain access prompt can be answered.
  json="$(read_keychain_creds_guarded "$svc" 300 || true)"
  if [[ -z "$json" ]] && ! claude_version_at_least "$RUN_ISOLATION_MIN_VERSION"; then
    json="$(read_keychain_creds || true)"
  fi
  [[ -n "$json" ]] || return 1
  printf '%s' "$json" > "$creds"
  chmod 600 "$creds" 2>/dev/null || true
  [[ -s "$creds" ]]
}

# The expiresAt (ms since epoch) of a credentials JSON file, or 0.
creds_expires_at() {
  [[ -f "$1" ]] || { printf '0'; return 0; }
  ruby -rjson -e 'begin; d=JSON.parse(File.read(ARGV[0])); rescue; print "0"; exit 0; end; print(((d["claudeAiOauth"]||{})["expiresAt"]||0).to_i)' "$1" 2>/dev/null || printf '0'
}

# Pull a profile's OWN namespaced Keychain item back into its .credentials.json.
#
# A `run` session (see run_profile) points Claude Code at the profile's private
# credential item, and the CLI refreshes the token in place there — the file
# claudius treats as the source of truth goes stale, and Claude Code's composite
# store DELETES the plaintext copy outright once it has written the Keychain
# successfully. So after a run we adopt the Keychain copy whenever it is newer
# (or the file is gone). Only ever writes the profile's own dir; never the live
# item, never ~/.claude. No-op off macOS.
sync_profile_creds_from_keychain() {
  local name="$1"
  local dir="$PROFILE_ROOT/$name"
  local creds="$dir/.credentials.json"
  keychain_available || return 1
  [[ -d "$dir" ]] || return 1

  local svc json
  svc="$(keychain_service_for_dir "$dir")" || return 1
  [[ "$svc" != "$KEYCHAIN_SERVICE" ]] || return 1  # refuse to read the live item
  json="$(read_keychain_creds_guarded "$svc")" || return 1
  [[ -n "$json" ]] || return 1

  local tmp; tmp="$(mktemp "${TMPDIR:-/tmp}/claudius.sync.XXXXXX")" || return 1
  chmod 600 "$tmp" 2>/dev/null || true
  printf '%s' "$json" > "$tmp"
  # Ignore anything unparseable or without a token rather than clobbering a good file.
  local have want
  want="$(creds_expires_at "$tmp")"
  if [[ "$want" == "0" ]]; then rm -f "$tmp"; return 1; fi
  have="$(creds_expires_at "$creds")"
  if [[ -f "$creds" ]] && (( want <= have )); then rm -f "$tmp"; return 1; fi
  mv "$tmp" "$creds" || { rm -f "$tmp"; return 1; }
  chmod 600 "$creds" 2>/dev/null || true
  return 0
}

# ── Credentials / usage probing ───────────────────────────────────────────────
# Read the OAuth access token from a credentials file (defaults to the live one).
get_access_token() {
  local creds_file="${1:-${CLAUDE_DIR}/.credentials.json}"
  # For the LIVE credential (no explicit file arg) on macOS, read the Keychain
  # first: it is the source of truth the CLI keeps fresh, whereas the ~/.claude
  # file is only a snapshot written at activation time and can be stale. Parse
  # straight from the Keychain JSON so nothing is written to disk.
  if [[ $# -eq 0 ]] && keychain_available; then
    local kc; kc="$(read_keychain_creds)"
    if [[ -n "$kc" ]]; then
      printf '%s' "$kc" | ruby -rjson -e 'begin; d=JSON.parse(STDIN.read); rescue; exit 0; end; puts(d.fetch("claudeAiOauth",{}).fetch("accessToken","")||"")'
      return 0
    fi
  fi
  [[ -f "$creds_file" ]] || return 1
  ruby - "$creds_file" <<'RB'
require 'json'
begin
  data = JSON.parse(File.read(ARGV[0]))
rescue
  exit 0
end
puts(data.fetch("claudeAiOauth", {}).fetch("accessToken", "") || "")
RB
}

# Probe the API rate-limit headers for a given token. Prints a human-readable
# "5h N% (resets …) · 7d N% (resets …)" string (empty when unavailable) and, when
# a cache path is given, writes that profile's ".usage" cache. Costs 1 token.
fetch_usage() {
  local token="$1" cache_path="${2:-}"
  [[ -n "$token" ]] || return 0

  ruby - "$token" "$cache_path" <<'RB'
require 'json'
require 'net/http'
require 'uri'
require 'fileutils'

token = ARGV[0]
cache_path = ARGV[1].to_s

# Issue the 1-token probe and read the rate-limit response headers directly.
# On ANY error, degrade to empty output exactly like the old curl path.
h = {}
begin
  uri = URI('https://api.anthropic.com/v1/messages')
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = true
  http.open_timeout = 15
  http.read_timeout = 15
  req = Net::HTTP::Post.new(uri)
  req['authorization'] = "Bearer #{token}"
  req['anthropic-version'] = '2023-06-01'
  req['anthropic-beta'] = 'oauth-2025-04-20'
  req['content-type'] = 'application/json'
  req.body = JSON.generate(
    "model" => "claude-haiku-4-5-20251001",
    "max_tokens" => 1,
    "messages" => [{ "role" => "user", "content" => "hi" }]
  )
  resp = http.request(req)
  resp.each_header do |k, v|
    kl = k.downcase
    h[kl] = v if kl.start_with?('anthropic-ratelimit-unified-')
  end
rescue
  exit 0
end

now = Time.now.to_f

countdown = lambda do |epoch|
  begin
    secs = epoch.to_i - now
  rescue
    return ""
  end
  return "now" if secs <= 0
  mins = (secs / 60).to_i
  return "#{mins}m" if mins < 60
  hrs = mins / 60.0
  hrs < 48 ? format("%.0fh", hrs) : format("%.0fd", hrs / 24)
end

pct_int = lambda do |v|
  begin
    (Float(v) * 100).round
  rescue
    nil
  end
end

parts = []
cache = {}
resets = {}
[["5h", "5h"], ["7d", "7d"]].each do |label, key|
  u = h["anthropic-ratelimit-unified-#{key}-utilization"]
  r = h["anthropic-ratelimit-unified-#{key}-reset"]
  p = u.nil? ? nil : pct_int.call(u)
  next if p.nil?
  cache[key] = p
  resets[key] = r.to_i if r && r.to_s =~ /\A\d+\z/
  tok = "#{label} #{p}%"
  cd = r ? countdown.call(r) : ""
  tok += " (resets #{cd})" unless cd.empty?
  parts << tok
end

if !cache_path.empty? && (cache.key?("5h") || cache.key?("7d"))
  begin
    dir = File.dirname(cache_path)
    FileUtils.mkdir_p(dir) unless dir.empty?
    # Cache line format: "u5 u7 uts r5 r7" — utilization %, cache epoch, then the
    # 5h/7d reset epochs. "-" placeholders keep every field positional even when a
    # window is missing, so a positional `read -r u5 u7 uts …` can never shift left.
    # (Trailing r5/r7 were added later; older 3-field caches still parse fine.)
    File.write(cache_path,
      "#{cache.fetch('5h', '-')} #{cache.fetch('7d', '-')} #{now.to_i} " \
      "#{resets.fetch('5h', '-')} #{resets.fetch('7d', '-')}\n")
    File.chmod(0o600, cache_path)
  rescue
  end
  # …and append the same reading to the history log, which is what turns a
  # snapshot into a burn rate. Timestamp first here: a log is read in time order
  # and sorted on its first field. Appenders are deliberately dumb — one line,
  # never a rewrite — so the file's shape is decided in exactly one place
  # (usage_history_json prunes it). See SAMPLE_MIN for the sampling interval.
  begin
    log_path = cache_path + ".log"
    last = 0
    if File.exist?(log_path)
      tail = File.open(log_path, 'rb') do |f|
        f.seek(-[f.size, 256].min, IO::SEEK_END)
        f.read
      end
      last = tail.to_s.split("\n").last.to_s.split.first.to_i
    end
    if now.to_i - last >= 120
      File.open(log_path, 'a') do |f|
        f.write("#{now.to_i} #{cache.fetch('5h', '-')} #{cache.fetch('7d', '-')} " \
                "#{resets.fetch('5h', '-')} #{resets.fetch('7d', '-')}\n")
      end
      File.chmod(0o600, log_path)
    end
  rescue
  end
end

puts parts.join(" · ")
RB
}

# True (exit 0) when the OAuth access token in $1 is missing or at/near expiry.
# A 60s skew means we refresh just before the token actually lapses.
token_expired() {
  local creds="$1"
  [[ -f "$creds" ]] || return 0
  ruby - "$creds" <<'RB'
require 'json'
begin
  d = JSON.parse(File.read(ARGV[0]))["claudeAiOauth"]
rescue
  exit 0  # unreadable → treat as expired
end
exp = d && d["expiresAt"]
exit(exp && exp / 1000.0 > Time.now.to_f + 60 ? 1 : 0)
RB
}

# Refresh the OAuth token in a profile's credentials file DIRECTLY via the token
# endpoint, using its stored refresh token. This touches neither the Keychain nor
# the live account, so it safely refreshes a NON-ACTIVE profile — something the
# CLI-based refresh cannot do on macOS, where every config dir shares one Keychain
# item and `claude` only ever refreshes whatever is currently live. Refresh tokens
# rotate, so the new refresh token is persisted next to the new access token.
# Returns 0 only when the file ends up with a fresh (unexpired) token.
oauth_refresh_creds() {
  local creds="$1"
  [[ -f "$creds" ]] || return 1
  ruby - "$creds" "$OAUTH_TOKEN_URL" "$OAUTH_CLIENT_ID" <<'RB'
require 'json'
require 'net/http'
require 'uri'

path, token_url, client_id = ARGV[0], ARGV[1], ARGV[2]
begin
  data = JSON.parse(File.read(path))
rescue
  exit 1
end
oauth = data["claudeAiOauth"]
exit 1 unless oauth.is_a?(Hash)
refresh = oauth["refreshToken"].to_s
exit 1 if refresh.empty?
scopes = oauth["scopes"]
scope = (scopes.is_a?(Array) && !scopes.empty?) ? scopes.join(" ") : "user:inference user:profile"

begin
  uri = URI(token_url)
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = true
  http.open_timeout = 15
  http.read_timeout = 15
  req = Net::HTTP::Post.new(uri)
  req['Content-Type'] = 'application/json'
  req['anthropic-beta'] = 'oauth-2025-04-20'
  req.body = JSON.generate(
    "grant_type" => "refresh_token",
    "refresh_token" => refresh,
    "client_id" => client_id,
    "scope" => scope
  )
  resp = http.request(req)
rescue
  exit 1
end
exit 1 unless resp.is_a?(Net::HTTPSuccess)
begin
  body = JSON.parse(resp.body)
rescue
  exit 1
end
at = body["access_token"].to_s
exit 1 if at.empty?

oauth["accessToken"] = at
oauth["refreshToken"] = body["refresh_token"] unless body["refresh_token"].to_s.empty?
oauth["expiresAt"] = ((Time.now.to_f + body["expires_in"].to_i) * 1000).to_i if body["expires_in"]
oauth["scopes"] = body["scope"].split(" ") if body["scope"] && !body["scope"].to_s.empty?
data["claudeAiOauth"] = oauth

begin
  tmp = path + ".tmp"
  File.write(tmp, JSON.generate(data))
  File.chmod(0o600, tmp)
  File.rename(tmp, path)
rescue
  exit 1
end
exit 0
RB
}

# Mint a fresh OAuth token for a stored profile whose token has expired. On macOS
# we refresh directly against the token endpoint (oauth_refresh_creds) so a
# non-active profile can be renewed without disturbing the live Keychain account.
# Elsewhere we point the CLI at the profile's config dir and make one cheap
# authenticated request, which transparently refreshes the token and writes the new
# credentials back into the dir. Returns 0 if the stored token is fresh afterwards.
refresh_profile_token() {
  # Two `local`s deliberately: within a single `local`, a later assignment cannot
  # see an earlier one on the same line (it expands to the pre-declaration value),
  # which silently made `dir` just "$PROFILE_ROOT/".
  local name="$1"
  local dir="$PROFILE_ROOT/$name"
  if keychain_available; then
    oauth_refresh_creds "$dir/.credentials.json"
    return
  fi
  command -v claude >/dev/null 2>&1 || return 1
  local runner=(claude -p "hi" --model claude-haiku-4-5-20251001)
  if command -v timeout >/dev/null 2>&1; then
    CLAUDE_CONFIG_DIR="$dir" timeout 90 "${runner[@]}" >/dev/null 2>&1 || true
  else
    CLAUDE_CONFIG_DIR="$dir" "${runner[@]}" >/dev/null 2>&1 || true
  fi
  [[ -f "$dir/.credentials.json" ]] && ! token_expired "$dir/.credentials.json"
}

# Refresh one profile's usage cache. Getting a WORKING token is the crux, and the
# hard constraint is DON'T rotate the token of the account that's currently live —
# OAuth refresh tokens are single-use and rotate server-side, so refreshing a
# profile that shares the live session's account invalidates that live session
# (a logout). Strategy:
#   • macOS: the live account is whatever is in the shared Keychain, NOT whatever
#     claudius's .active_profile says. If the profile's account == the live account,
#     read the fresh token straight from the Keychain (no rotation). Only a profile
#     bound to a DIFFERENT account is refreshed directly against the token endpoint.
#   • Linux: use the live ~/.claude token for the active profile; otherwise let the
#     CLI refresh the profile's stored token in its own config dir.
# Returns 0 ONLY if the cache was actually rewritten (detected via mtime) — the old
# implementation returned 0 whenever the stale cache file merely existed, which made
# a silent 401 look like a successful refresh.
refresh_profile_usage() {
  local name="$1"
  local dir="$PROFILE_ROOT/$name"
  local cache_path="$dir/.usage"
  local creds="$dir/.credentials.json"

  local active; active="$(get_active_profile || true)"
  local ptoken=""
  if keychain_available; then
    # macOS: decide by the LIVE account identity, not the .active_profile marker.
    local live pemail; live="$(live_account_email)"; pemail="$(profile_account_email "$name")"
    if [[ -n "$live" && -n "$pemail" && "$pemail" == "$live" ]]; then
      # Same account as the live session — rotating its token would log it out, so
      # read the fresh token from the Keychain instead of ever refreshing it.
      ptoken="$(get_access_token || true)"
    else
      # A genuinely different account: safe to refresh directly (its refresh chain
      # is independent of the live session's). Only refresh when actually expired.
      # A `run` session may already have renewed it into the profile's own Keychain
      # item — adopt that first so we don't rotate for nothing.
      sync_profile_creds_from_keychain "$name" || true
      if token_expired "$creds"; then
        refresh_profile_token "$name" || true
      fi
      ptoken="$(get_access_token "$creds" || true)"
    fi
  elif [[ "$name" == "$active" && -f "$CLAUDE_DIR/.credentials.json" ]] \
       && ! token_expired "$CLAUDE_DIR/.credentials.json"; then
    ptoken="$(get_access_token "$CLAUDE_DIR/.credentials.json" || true)"
  else
    if token_expired "$creds"; then
      refresh_profile_token "$name" || true
    fi
    ptoken="$(get_access_token "$creds" || true)"
  fi
  [[ -n "$ptoken" ]] || return 1

  local before after
  before="$(file_mtime "$cache_path")"
  fetch_usage "$ptoken" "$cache_path" >/dev/null 2>&1 || true
  after="$(file_mtime "$cache_path")"
  [[ "$after" != "$before" ]]
}

# Load a profile's cached usage into RU5/RU7/RUTS. "-" placeholders (written when a
# window is missing) map back to empty. Returns 1 when there is no cache file.
read_usage_cache() {
  RU5=""; RU7=""; RUTS=""
  local f="$PROFILE_ROOT/$1/.usage"
  [[ -f "$f" ]] || return 1
  read -r RU5 RU7 RUTS < "$f" 2>/dev/null || true
  [[ "$RU5" == "-" ]] && RU5=""
  [[ "$RU7" == "-" ]] && RU7=""
  return 0
}

# Print a one-line account summary (identity + real 5h/7d usage + reset
# countdowns from the API rate-limit headers). If a profile name is given, also
# writes that profile's .usage cache so the menu can show it later.
# Degrades gracefully (identity only) when offline or curl is unavailable.
show_account_status() {
  local cache_profile="${1:-}"
  local cache_path=""
  [[ -n "$cache_profile" ]] && cache_path="$PROFILE_ROOT/$cache_profile/.usage"

  local identity="claude"
  local auth_status_json
  auth_status_json="$(claude auth status 2>/dev/null || true)"
  if [[ -n "$auth_status_json" ]]; then
    identity="$(ruby - "$auth_status_json" <<'RB'
require 'json'
begin
  data = JSON.parse(ARGV[0])
rescue
  data = {}
end
email = data["email"] || data["user"] || "claude"
sub = data["subscriptionType"] || ""
puts(sub.empty? ? email : "#{email} · #{sub}")
RB
)"
  fi

  local limits token
  token="$(get_access_token || true)"
  limits="$(fetch_usage "$token" "$cache_path")"

  if [[ -n "$limits" ]]; then
    printf '%s%s%s %s·%s %s\n' "$C_BOLD" "$identity" "$C_RESET" "$C_MUTED" "$C_RESET" "$limits"
  else
    printf '%s%s%s\n' "$C_BOLD" "$identity" "$C_RESET"
  fi
}

# Emit "email<TAB>org<TAB>sub" for a stored profile (empty fields when missing).
profile_meta() {
  local dir="$PROFILE_ROOT/$1"
  ruby - "$dir" <<'RB'
require 'json'
d = ARGV[0]
email = org = sub = ""
id_path = File.join(d, ".claude.json")
id_path = File.join(d, "claude.json") unless File.exist?(id_path)  # legacy pre-config-dir name
begin
  j = JSON.parse(File.read(id_path))
  acc = j["oauthAccount"] || {}
  email = acc["emailAddress"] || ""
  org = acc["organizationName"] || ""
rescue
end
begin
  c = JSON.parse(File.read(File.join(d, ".credentials.json")))
  sub = (c["claudeAiOauth"] || {})["subscriptionType"] || ""
rescue
end
puts [email, org, sub].join("\t")
RB
}

# ── Setup / storage ───────────────────────────────────────────────────────────
require_claude() {
  if ! command -v claude >/dev/null 2>&1; then
    echo "Claude CLI was not found on PATH." >&2
    echo "Install it first or add it to your PATH." >&2
    exit 1
  fi
}

# Ruby is the engine for every subcommand (all the JSON/token/usage logic runs in
# embedded Ruby). Verify the interpreter and the stdlib modules we rely on are all
# present up front, so a missing dependency fails with a clear message instead of a
# cryptic error deep inside a heredoc.
require_ruby() {
  if ! command -v ruby >/dev/null 2>&1; then
    echo "Ruby was not found on PATH." >&2
    echo "Install Ruby (>= 2.5) — e.g. 'sudo apt install ruby' or 'brew install ruby'." >&2
    exit 1
  fi
  if ! ruby -e "require 'json'; require 'net/http'" >/dev/null 2>&1; then
    echo "This Ruby is missing required stdlib modules (json, net/http)." >&2
    echo "Install a complete Ruby distribution and try again." >&2
    exit 1
  fi
}

# The dashboard sidecar needs the 'webrick' HTTP server. It ships with Ruby < 3.0
# but is a separate gem on 3.0+, so check it only when 'serve' is invoked and point
# the user at the one-line fix rather than letting the sidecar crash on require.
require_webrick() {
  if ! ruby -e "require 'webrick'" >/dev/null 2>&1; then
    echo "The dashboard needs the 'webrick' gem, which isn't available." >&2
    echo "Install it with:  gem install webrick" >&2
    exit 1
  fi
}

ensure_storage() {
  mkdir -p "$PROFILE_ROOT"
  chmod 700 "$PROFILE_ROOT"
}

list_profiles() {
  # Pure-shell directory listing — BSD/macOS `find` has no `-printf`. The `*/` glob
  # skips dotfiles by default; when there are no profile dirs the glob stays literal
  # and the `-d` test drops it, so nothing is printed.
  local d
  for d in "$PROFILE_ROOT"/*/; do
    [[ -d "$d" ]] || continue
    d="${d%/}"
    printf '%s\n' "${d##*/}"
  done | sort
}

get_active_profile() {
  if [[ -f "$ACTIVE_PROFILE_FILE" ]]; then
    cat "$ACTIVE_PROFILE_FILE"
  fi
}

sanitize_profile_name() {
  local raw_name="${1:-}"
  local sanitized
  sanitized="$(echo "$raw_name" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/-/g; s/--*/-/g; s/^[-.]*//; s/[-.]*$//')"
  if [[ -z "$sanitized" ]]; then
    sanitized="profile-$(date +%Y%m%d-%H%M%S)"
  fi
  echo "$sanitized"
}

# A profile directory IS a usable CLAUDE_CONFIG_DIR — point `claude` (or T3) at it
# via CLAUDE_CONFIG_DIR=<profile dir>. It holds the two files Claude reads there:
#   <profile>/.credentials.json  <- ~/.claude/.credentials.json
#   <profile>/.claude.json       <- ~/.claude.json (account identity / config)
# (Older profiles used the un-dotted "claude.json"; reads fall back to it.)

# Resolve a profile's identity file for READING (new dotted name, else legacy).
profile_identity_path() {
  local dir="$1"
  if [[ -f "$dir/.claude.json" ]]; then printf '%s' "$dir/.claude.json"
  elif [[ -f "$dir/claude.json" ]]; then printf '%s' "$dir/claude.json"
  else printf '%s' "$dir/.claude.json"; fi
}

# Installed CLI version (e.g. 2.1.200), cached for the process. Empty if unknown.
CLAUDE_VERSION=""
claude_version() {
  if [[ -z "$CLAUDE_VERSION" ]]; then
    CLAUDE_VERSION="$(claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
  fi
  printf '%s' "$CLAUDE_VERSION"
}

# True when the installed CLI is at least version $1. Unknown version → false, so
# callers degrade to the conservative path rather than assuming a new feature.
claude_version_at_least() {
  local have; have="$(claude_version)"
  [[ -n "$have" ]] || return 1
  ruby -rrubygems -e 'exit(Gem::Version.new(ARGV[0]) >= Gem::Version.new(ARGV[1]) ? 0 : 1)' \
    "$have" "$1" 2>/dev/null
}

# Make a profile dir safe to use DIRECTLY as CLAUDE_CONFIG_DIR (the whole point of
# the config-dir support). A profile born from the isolated `claude auth login`
# gets a .claude.json WITHOUT `hasCompletedOnboarding` (that flag is only written
# once the interactive onboarding wizard finishes). Pointing CLAUDE_CONFIG_DIR at
# such a dir re-runs onboarding — which prompts to log in again even though the
# stored credentials are valid. Stamp the "already onboarded" markers so it won't.
# Also migrates a legacy un-dotted claude.json to the dotted name claude reads as a
# config dir. Idempotent (no write when already correct); preserves all fields.
normalize_profile_identity() {
  local name="$1"
  local dir="$PROFILE_ROOT/$name"
  local dotted="$dir/.claude.json"
  local legacy="$dir/claude.json"

  if [[ ! -f "$dotted" && -f "$legacy" ]]; then
    cp "$legacy" "$dotted" 2>/dev/null || true
    chmod 600 "$dotted" 2>/dev/null || true
  fi

  ruby - "$dotted" "$(claude_version)" <<'RB'
require 'json'
path, ver = ARGV[0], ARGV[1]
begin
  data = JSON.parse(File.read(path))
rescue
  data = {}
end
data = {} unless data.is_a?(Hash)
changed = false
if data["hasCompletedOnboarding"] != true
  data["hasCompletedOnboarding"] = true
  changed = true
end
if ver && !ver.empty? && data["lastOnboardingVersion"] != ver
  data["lastOnboardingVersion"] = ver
  changed = true
end
if changed
  tmp = path + ".tmp"
  File.write(tmp, JSON.generate(data))
  File.rename(tmp, path)
  File.chmod(0o600, path)
end
RB
}

# One-time (idempotent) migration of all stored profiles at startup.
migrate_profiles() {
  local n
  while IFS= read -r n; do
    [[ -n "$n" ]] && normalize_profile_identity "$n"
  done < <(list_profiles)
}

save_current_profile() {
  local name="$1"
  local target_dir="$PROFILE_ROOT/$name"

  mkdir -p "$target_dir"

  # Capture the live credential. On macOS the source of truth is the Keychain
  # (kept fresh by the CLI); elsewhere it's the global .credentials.json file.
  if keychain_available; then
    local json; json="$(read_keychain_creds)"
    if [[ -n "$json" ]]; then
      printf '%s' "$json" > "$target_dir/.credentials.json"
      chmod 600 "$target_dir/.credentials.json" 2>/dev/null || true
    fi
  elif [[ -f "$CLAUDE_DIR/.credentials.json" ]]; then
    cp "$CLAUDE_DIR/.credentials.json" "$target_dir/.credentials.json"
    chmod 600 "$target_dir/.credentials.json" 2>/dev/null || true
  fi
  if [[ -f "$CLAUDE_CONFIG" ]]; then
    cp "$CLAUDE_CONFIG" "$target_dir/.claude.json"
    chmod 600 "$target_dir/.claude.json" 2>/dev/null || true
  fi
}

activate_profile() {
  local name="$1"
  local save_current_state="${2:-true}"
  local source_dir="$PROFILE_ROOT/$name"

  if [[ ! -d "$source_dir" ]]; then
    echo "Profile '$name' does not exist." >&2
    return 1
  fi

  # Ensure the identity we're about to copy into ~/.claude is marked onboarded, so
  # bare `claude` doesn't re-run onboarding after a switch either.
  normalize_profile_identity "$name"

  local current_active
  current_active="$(get_active_profile || true)"

  if [[ "$save_current_state" == "true" && -n "$current_active" && "$current_active" != "$name" ]]; then
    save_current_profile "$current_active" >/dev/null 2>&1 || true
  fi

  # A `run` session may have migrated this profile's token into its own Keychain
  # item and taken the plaintext copy with it; recover that before deciding the
  # profile has nothing to activate.
  sync_profile_creds_from_keychain "$name" || true

  if [[ ! -f "$source_dir/.credentials.json" ]]; then
    echo "Profile '$name' has no saved credentials; cannot activate." >&2
    return 1
  fi

  mkdir -p "$CLAUDE_DIR"
  cp "$source_dir/.credentials.json" "$CLAUDE_DIR/.credentials.json"
  chmod 600 "$CLAUDE_DIR/.credentials.json" 2>/dev/null || true
  # macOS reads the live token from the Keychain, not this file — push it in so a
  # bare `claude` (and any CLAUDE_CONFIG_DIR session) uses the activated account.
  write_keychain_creds "$source_dir/.credentials.json" || true
  local id_file
  id_file="$(profile_identity_path "$source_dir")"
  if [[ -f "$id_file" ]]; then
    cp "$id_file" "$CLAUDE_CONFIG"
    chmod 600 "$CLAUDE_CONFIG" 2>/dev/null || true
  fi

  printf '%s\n' "$name" > "$ACTIVE_PROFILE_FILE"
  chmod 600 "$ACTIVE_PROFILE_FILE" 2>/dev/null || true
  printf '%s✓%s Activated Claude profile: %s%s%s\n' "$C_GREEN" "$C_RESET" "$C_BOLD" "$name" "$C_RESET"
  show_account_status "$name"
  # This profile dir also works directly as a config dir (e.g. for T3) — and
  # `run` is the supported way to use it, without disturbing the global account.
  printf '%s  config dir:%s %s%s%s\n' "$C_MUTED" "$C_RESET" "$C_ACCENT" "$source_dir" "$C_RESET"
  printf '%s  open a session without switching accounts:%s %s run %s\n' \
    "$C_MUTED" "$C_RESET" "$(basename "$0")" "$name"
}

# Delete a stored profile (its whole config dir: credentials, identity, usage
# cache, backups). Deliberately does NOT touch the live session — on macOS the
# credential lives in the shared Keychain and on Linux in ~/.claude, neither of
# which we clear here; removing a stored profile just forgets claudius's saved
# copy, it never logs you out. If the removed profile was the recorded active one,
# clear the .active_profile marker so nothing points at a now-missing dir. No
# prompting here — callers confirm.
remove_profile() {
  local name="$1"
  local dir="$PROFILE_ROOT/$name"
  if [[ ! -d "$dir" ]]; then
    echo "Profile '$name' does not exist." >&2
    return 1
  fi
  # Guard against a malformed name resolving outside the profile root.
  case "$name" in
    ""|*/*|.|..) echo "Refusing to remove invalid profile name '$name'." >&2; return 1 ;;
  esac
  rm -rf "$dir"
  local active; active="$(get_active_profile || true)"
  [[ "$active" == "$name" ]] && rm -f "$ACTIVE_PROFILE_FILE"
  return 0
}

# ── Shared-session wiring ─────────────────────────────────────────────────────
# A profile dir is a full CLAUDE_CONFIG_DIR, so a session launched in one sees
# NONE of your global ~/.claude by default: no agents, no slash commands, and —
# the big one — no conversation history, so `claude -c` / `--resume` come up
# empty. `claudius run` therefore wires the profile to SHARE the global ~/.claude
# as a single pool, symlinking every entry except the few that must stay
# per-account. Sharing is the deliberate point: multiple accounts should separate
# identity and billing, not your work. Because the pool IS ~/.claude, a session
# started by bare `claude` participates too — resume it from any profile, and
# vice versa.
#
# It's a DENYLIST, not an allowlist: whatever Claude Code adds to ~/.claude in
# future is shared automatically rather than silently missing from run sessions.

# Entries that are NEVER linked: they define which account this is, or they are
# per-process runtime state that two sessions must not share.
share_is_isolated() {
  case "$1" in
    # Identity + token — the entire reason profiles exist.
    .credentials.json|.claude.json|claude.json) return 0 ;;
    # Merged key-by-key instead (see merge_profile_settings) so each profile can
    # keep its own statusLine while inheriting global permissions/hooks/env.
    settings.json|settings.json.bak|settings.local.json) return 0 ;;
    # claudius's own per-profile state.
    .usage|backups) return 0 ;;
    # Runtime/pid state: locks, the background daemon, IDE handshake files.
    daemon|daemon.*|daemon-*|ide) return 0 ;;
    *.lock|*.pid|*.tmp) return 0 ;;
    # Never re-link something we set aside earlier.
    *.pre-share.bak) return 0 ;;
    ''|.|..) return 0 ;;
  esac
  return 1
}

# Names of the immediate children of ~/.claude, dotfiles included. Uses a
# subshell so `dotglob`/`nullglob` never leak into the rest of the script.
share_entries() {
  ( shopt -s nullglob dotglob
    local p
    for p in "$CLAUDE_DIR"/*; do
      printf '%s\n' "${p##*/}"
    done )
}

# What a merge would actually do to this entry, for the confirmation prompt. Kept
# in step with the act loop in wire_profile_sharing — a prompt that misdescribes
# the work is worse than no prompt.
share_merge_note() {
  local own="$1" pool="$2"
  if [[ -d "$own" ]]; then
    local n=0
    n="$(share_missing_children "$own" "$pool" | wc -l | tr -d ' ')"
    printf '%s item(s) copied into the pool' "$n"
  elif [[ ! -e "$pool" ]]; then
    printf 'moved into the pool'
  elif [[ "$own" == *.jsonl ]]; then
    printf 'new lines appended (duplicates skipped)'
  else
    printf 'kept as a backup only (the pool already has one)'
  fi
}

# Children of $1 that the pool $2 does not already have.
share_missing_children() {
  ( shopt -s nullglob dotglob
    local c b
    for c in "$1"/*; do
      b="${c##*/}"
      [[ -e "$2/$b" ]] && continue
      printf '%s\n' "$b"
    done )
}

# ── Plan / act ────────────────────────────────────────────────────────────────
# Planning is strictly read-only so the confirmation prompt can describe exactly
# what will happen before anything on disk moves.
SHARE_PLAN_LINK=()     # nothing in the way — just symlink (silent)
SHARE_PLAN_RELINK=()   # a symlink pointing somewhere else — repoint (silent)
SHARE_PLAN_MERGE=()    # REAL data in the profile — merge + set aside (confirm)
SHARE_PLAN_NOTE=()     # parallel to SHARE_PLAN_MERGE

share_plan() {
  local dir="$1"
  SHARE_PLAN_LINK=(); SHARE_PLAN_RELINK=(); SHARE_PLAN_MERGE=(); SHARE_PLAN_NOTE=()
  [[ -d "$CLAUDE_DIR" ]] || return 0
  local entry src dst
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    share_is_isolated "$entry" && continue
    src="$CLAUDE_DIR/$entry"
    dst="$dir/$entry"
    if [[ -L "$dst" ]]; then
      [[ "$(readlink "$dst" 2>/dev/null)" == "$src" ]] && continue
      SHARE_PLAN_RELINK+=("$entry")
    elif [[ -e "$dst" ]]; then
      SHARE_PLAN_MERGE+=("$entry")
      SHARE_PLAN_NOTE+=("$(share_merge_note "$dst" "$src")")
    else
      SHARE_PLAN_LINK+=("$entry")
    fi
  done < <(share_entries)
}

# Fold a profile's own directory into the shared pool: copy only what the pool
# lacks, so nothing already there is overwritten.
share_merge_dir() {
  local own="$1" pool="$2" b
  mkdir -p "$pool"
  while IFS= read -r b; do
    [[ -n "$b" ]] || continue
    cp -R "$own/$b" "$pool/$b" 2>/dev/null || true
  done < <(share_missing_children "$own" "$pool")
}

# Append a profile's JSONL lines to the pool's copy, skipping lines already
# present. Used for history.jsonl (prompt recall), where order is chronological
# and exact-duplicate lines carry no extra information.
share_merge_jsonl() {
  local own="$1" pool="$2"
  ruby - "$own" "$pool" <<'RB'
own, pool = ARGV[0], ARGV[1]
seen = {}
if File.file?(pool)
  begin
    File.foreach(pool) { |l| seen[l.chomp] = true }
  rescue
  end
end
add = []
begin
  File.foreach(own) do |l|
    l = l.chomp
    next if l.empty? || seen[l]
    seen[l] = true
    add << l
  end
rescue
  exit 0
end
exit 0 if add.empty?
begin
  File.open(pool, 'a') { |f| add.each { |l| f.puts l } }
rescue
  exit 1
end
RB
}

# Set a profile's own copy aside under a .pre-share.bak name that doesn't collide
# with an earlier one. Prints the chosen path.
share_set_aside() {
  local path="$1" bak="$1.pre-share.bak" i=2
  while [[ -e "$bak" ]]; do
    bak="$1.pre-share.$i.bak"
    i=$(( i + 1 ))
  done
  mv "$path" "$bak" && printf '%s' "$bak"
}

# Wire one profile to the shared pool. Idempotent: re-running only fixes what is
# missing or mis-pointed. $2 = how to handle a merge that would move real data:
# true = prompt, false = refuse (non-interactive), auto = proceed (only for a
# profile this same command just created, whose contents are seconds-old login
# scaffolding rather than anything the user made).
# Returns nonzero only when a merge was needed and could not be confirmed.
wire_profile_sharing() {
  local name="$1" interactive="${2:-true}"
  local dir="$PROFILE_ROOT/$name"
  [[ -d "$dir" ]] || return 1
  [[ -d "$CLAUDE_DIR" ]] || return 0

  share_plan "$dir"

  local n_merge=${#SHARE_PLAN_MERGE[@]} i
  if (( n_merge > 0 )) && [[ "$interactive" != auto ]]; then
    # Real data would move. Describe it precisely, then ask — a symlink is
    # reversible, a merged history is not.
    printf "\n%s'%s' has its own session data.%s Wiring it for sharing will:\n" \
      "$C_AMBER" "$name" "$C_RESET"
    for (( i = 0; i < n_merge; i++ )); do
      printf '  %s•%s %-18s %s\n' "$C_MUTED" "$C_RESET" \
        "${SHARE_PLAN_MERGE[$i]}" "${SHARE_PLAN_NOTE[$i]}"
    done
    printf '  %sthen each is set aside as <name>.pre-share.bak and replaced with a\n' "$C_MUTED"
    printf '  symlink into %s%s\n' "$CLAUDE_DIR" "$C_RESET"
    if [[ "$interactive" != true ]]; then
      printf '\n%sRefusing to move data without confirmation.%s Run `%s link %s` in a terminal first.\n' \
        "$C_AMBER" "$C_RESET" "$(basename "$0")" "$name" >&2
      return 1
    fi
    printf '\nProceed? %s[y/N]%s ' "$C_MUTED" "$C_RESET"
    local reply=""
    read -r reply || reply=""
    case "$reply" in
      y|Y|yes|YES) ;;
      *) echo "Cancelled."; return 1 ;;
    esac
  fi

  if (( n_merge > 0 )); then
    for (( i = 0; i < n_merge; i++ )); do
      local entry="${SHARE_PLAN_MERGE[$i]}"
      local own="$dir/$entry" pool="$CLAUDE_DIR/$entry"
      if [[ -d "$own" ]]; then
        share_merge_dir "$own" "$pool"
      elif [[ "$entry" == *.jsonl && -f "$pool" ]]; then
        share_merge_jsonl "$own" "$pool"
      elif [[ ! -e "$pool" ]]; then
        cp -R "$own" "$pool" 2>/dev/null || true
      fi
      share_set_aside "$own" >/dev/null || continue
      ln -s "$pool" "$own" 2>/dev/null || true
    done
  fi

  local entry
  if (( ${#SHARE_PLAN_RELINK[@]} > 0 )); then
    for entry in "${SHARE_PLAN_RELINK[@]}"; do
      rm -f "$dir/$entry"
      ln -s "$CLAUDE_DIR/$entry" "$dir/$entry" 2>/dev/null || true
    done
  fi
  if (( ${#SHARE_PLAN_LINK[@]} > 0 )); then
    for entry in "${SHARE_PLAN_LINK[@]}"; do
      ln -s "$CLAUDE_DIR/$entry" "$dir/$entry" 2>/dev/null || true
    done
  fi
  return 0
}

# Fill gaps in a profile's settings.json from the global one: permissions, hooks,
# env, model defaults and the like carry into run sessions, while any key the
# profile already has (notably claudius's own statusLine) wins. Backs the profile
# copy up once before the first rewrite. Same conservative merge as
# `claudius statusline` — other keys are never disturbed.
merge_profile_settings() {
  local name="$1"
  local dir="$PROFILE_ROOT/$name"
  local glob="$CLAUDE_DIR/settings.json"
  [[ -f "$glob" ]] || return 0
  ruby - "$dir/settings.json" "$glob" <<'RB'
require 'json'
prof, glob = ARGV[0], ARGV[1]
def load(p)
  return nil unless File.file?(p)
  d = JSON.parse(File.read(p)) rescue nil
  d.is_a?(Hash) ? d : nil
end
g = load(glob)
exit 0 unless g
p = load(prof) || {}
changed = false
g.each do |k, v|
  next if p.key?(k)
  p[k] = v
  changed = true
end
exit 0 unless changed
bak = prof + '.claudius-bak'
begin
  require 'fileutils'
  FileUtils.cp(prof, bak) if File.file?(prof) && !File.exist?(bak)
  tmp = prof + '.tmp'
  File.write(tmp, JSON.pretty_generate(p))
  File.chmod(0o600, tmp)
  File.rename(tmp, prof)
rescue
  exit 1
end
RB
}

# Per-project state (trust-dialog acceptance, allowedTools, project-scope MCP
# servers) lives in the `projects` key of the identity file — which cannot be
# symlinked, since the rest of that file is what makes the profile a distinct
# account. So copy across any project entry the profile lacks. Runs on every
# launch, not just the first, so repos you start using later don't re-prompt for
# trust in run sessions. `oauthAccount` and the profile's own entries are never
# touched.
sync_profile_projects_key() {
  local name="$1"
  local dir="$PROFILE_ROOT/$name"
  local prof; prof="$(profile_identity_path "$dir")"
  [[ -f "$CLAUDE_CONFIG" ]] || return 0
  ruby - "$prof" "$CLAUDE_CONFIG" <<'RB'
require 'json'
prof, glob = ARGV[0], ARGV[1]
def load(p)
  return nil unless File.file?(p)
  d = JSON.parse(File.read(p)) rescue nil
  d.is_a?(Hash) ? d : nil
end
g = load(glob) or exit 0
d = load(prof) or exit 0
gp = g['projects']
exit 0 unless gp.is_a?(Hash)
dp = d['projects']
dp = {} unless dp.is_a?(Hash)
changed = false
gp.each do |path, cfg|
  next if dp.key?(path)
  dp[path] = cfg
  changed = true
end
exit 0 unless changed
d['projects'] = dp
begin
  tmp = prof + '.tmp'
  File.write(tmp, JSON.generate(d))
  File.chmod(0o600, tmp)
  File.rename(tmp, prof)
rescue
  exit 1
end
RB
}

# ── Launching a session in a profile ──────────────────────────────────────────
# The account recorded in the GLOBAL identity file (~/.claude.json). Unlike
# live_account_email this works on Linux, where there is no Keychain and the
# global file is the live session's identity.
global_identity_email() {
  [[ -f "$CLAUDE_CONFIG" ]] || return 0
  ruby -rjson -e 'begin; d=JSON.parse(File.read(ARGV[0])); rescue; exit 0; end; puts((d["oauthAccount"]||{})["emailAddress"]||"")' \
    "$CLAUDE_CONFIG" 2>/dev/null
}

# Make sure the profile's stored token is usable before we hand off to claude.
# Deliberately free — no Haiku call, unlike refresh_profile_usage. Nonzero (with a
# message) only when the token is expired and cannot be renewed.
run_prepare_token() {
  local name="$1"
  local scope="${2:-shared}"
  local dir="$PROFILE_ROOT/$name"
  local creds="$dir/.credentials.json"

  if keychain_available; then
    if [[ "$scope" == "shared" ]]; then
      # This profile IS the live account and the session will read the shared
      # Keychain item, which the CLI keeps fresh. The file's own freshness is
      # irrelevant, and refreshing it here would rotate the live session's
      # single-use refresh token — i.e. log it out.
      return 0
    fi
    # Isolated scope: the session is seeded from this profile's OWN credential, so
    # the file's freshness is what matters again. A previous run may have left a
    # newer token in the profile's Keychain item; adopt that before refreshing, to
    # avoid a rotation we don't need.
    sync_profile_creds_from_keychain "$name" || true
    token_expired "$creds" || return 0
    printf '%s·%s token expired — refreshing… ' "$C_MUTED" "$C_RESET"
    # Safe to rotate: run_profile only chooses isolated scope for a profile bound
    # to a DIFFERENT account than the live session, so this refresh chain is not
    # one the live session holds.
    if oauth_refresh_creds "$creds"; then
      printf '%sok%s\n' "$C_GREEN" "$C_RESET"
      return 0
    fi
    printf '%sfailed%s\n' "$C_AMBER" "$C_RESET"
    printf "Could not renew the token for '%s'. Sign in again: %s add %s\n" \
      "$name" "$(basename "$0")" "$name" >&2
    return 1
  fi

  token_expired "$creds" || return 0

  # If this profile is the account currently live in ~/.claude and that copy is
  # still fresh, adopt it rather than rotating. OAuth refresh tokens are
  # single-use: rotating one that the live session also holds would log it out.
  local live_email prof_email
  live_email="$(global_identity_email)"
  prof_email="$(profile_account_email "$name")"
  if [[ -n "$live_email" && "$live_email" == "$prof_email" ]] &&
     [[ -f "$CLAUDE_DIR/.credentials.json" ]] &&
     ! token_expired "$CLAUDE_DIR/.credentials.json"; then
    cp "$CLAUDE_DIR/.credentials.json" "$creds"
    chmod 600 "$creds" 2>/dev/null || true
    return 0
  fi

  printf '%s·%s token expired — refreshing… ' "$C_MUTED" "$C_RESET"
  if oauth_refresh_creds "$creds"; then
    printf '%sok%s\n' "$C_GREEN" "$C_RESET"
    # Refresh tokens are single-use and rotate server-side. If the global session
    # is the SAME account, its stored copy just became stale, so hand it the new
    # credential rather than leaving a bare `claude` needing a re-login. Same
    # account, fresher token — exactly what activate_profile writes there anyway.
    if [[ -n "$live_email" && "$live_email" == "$prof_email" && -f "$CLAUDE_DIR/.credentials.json" ]]; then
      cp "$creds" "$CLAUDE_DIR/.credentials.json"
      chmod 600 "$CLAUDE_DIR/.credentials.json" 2>/dev/null || true
    fi
    return 0
  fi
  printf '%sfailed%s\n' "$C_AMBER" "$C_RESET"
  printf "Could not renew the token for '%s'. Sign in again: %s add %s\n" \
    "$name" "$(basename "$0")" "$name" >&2
  return 1
}

# Launch `claude` (plus any extra args) inside a profile's config dir, WITHOUT
# touching the global ~/.claude session or the active-profile marker.
#
# CREDENTIAL SCOPE — the whole macOS story. Claude Code namespaces its Keychain
# credential item per config dir (keychain_service_for_dir), so a run session can
# be pointed at either:
#
#   shared   — the live item. Chosen when the profile IS the live account. The
#              session and the live session share one credential, so a refresh
#              inside the session renews both instead of forking them. Critically,
#              this is what stops `run <live profile>` from rotating a single-use
#              refresh token behind the live session's back and logging it out.
#   isolated — the profile's OWN item, seeded from its .credentials.json. Chosen
#              for a profile bound to a different account: that account's refresh
#              chain is independent, so the session can renew freely. This is what
#              makes concurrent accounts work on macOS.
#
# CLAUDE_SECURESTORAGE_CONFIG_DIR selects between them: a path namespaces the item
# to that dir, the EMPTY STRING forces the shared default (the CLI reads unset vs
# empty differently — empty means "default dir", so it must be exported empty, not
# omitted). CLAUDE_CONFIG_DIR alone would namespace it implicitly; setting both
# keeps the choice explicit and independent of how the CLI resolves its config dir.
#
# When identities can't be resolved we refuse: guessing wrong either runs the wrong
# account silently (the old bug) or logs out the live session. Off macOS none of
# this applies — the token is a plain file in the config dir — and the session
# exec's exactly as before.
run_profile() {
  local name="$1"
  shift
  local dir="$PROFILE_ROOT/$name"

  if [[ ! -d "$dir" ]]; then
    echo "Profile '$name' does not exist." >&2
    return 1
  fi
  if [[ ! -f "$dir/.credentials.json" ]]; then
    echo "Profile '$name' has no saved credentials; cannot run it." >&2
    return 1
  fi

  local scope="shared"
  if keychain_available; then
    local live prof
    live="$(live_account_email)"
    prof="$(profile_account_email "$name")"
    if [[ -z "$live" || -z "$prof" ]]; then
      printf '%serror:%s cannot tell which account is live, so refusing to guess.\n' \
        "$C_AMBER" "$C_RESET" >&2
      printf '    live account: %s\n' "${live:-unknown}" >&2
      printf '    requested:    %s\n' "${prof:-unknown (no identity saved)}" >&2
      printf '  On macOS the credential is scoped per account; running the wrong one\n' >&2
      printf '  would either use the wrong identity or log out your live session.\n' >&2
      printf '  Check `claude auth status`, or run `%s activate %s` instead.\n' \
        "$(basename "$0")" "$name" >&2
      return 1
    fi
    if [[ "$live" != "$prof" ]]; then
      if ! claude_version_at_least "$RUN_ISOLATION_MIN_VERSION"; then
        printf '%serror:%s claude %s cannot scope the login Keychain per account,\n' \
          "$C_AMBER" "$C_RESET" "$(claude_version || echo "(unknown version)")" >&2
        printf '  so a session here would use whichever account is globally live.\n' >&2
        printf '    live account: %s\n' "$live" >&2
        printf '    requested:    %s\n' "$prof" >&2
        printf '  Upgrade to %s or newer, or run `%s activate %s` instead.\n' \
          "$RUN_ISOLATION_MIN_VERSION" "$(basename "$0")" "$name" >&2
        return 1
      fi
      scope="isolated"
    fi
  fi

  normalize_profile_identity "$name"
  run_prepare_token "$name" "$scope" || return 1

  local interactive=true
  { [[ -t 0 ]] && [[ -t 1 ]]; } || interactive=false
  wire_profile_sharing "$name" "$interactive" || return 1
  merge_profile_settings "$name" || true
  sync_profile_projects_key "$name" || true

  local email; email="$(profile_account_email "$name")"
  printf '%s·%s %s%s%s %s %s%s%s\n' \
    "$C_MUTED" "$C_RESET" "$C_BOLD" "$name" "$C_RESET" \
    "$GLYPH_DOT" "$C_DIM" "${email:-no identity saved}" "$C_RESET"

  if [[ "$scope" == "isolated" ]]; then
    printf '%s·%s %sown credential — the live account is untouched%s\n' \
      "$C_MUTED" "$C_RESET" "$C_DIM" "$C_RESET"
    local svc; svc="$(keychain_service_for_dir "$dir")"
    # Seed the profile's own Keychain item. Required, not merely an optimisation:
    # the Keychain is the PRIMARY store and wins over the plaintext fallback, so a
    # stale item left by an earlier session would shadow the credential we just
    # prepared. A write failure is survivable — the CLI falls back to the file.
    write_keychain_creds "$dir/.credentials.json" "$svc" || true
    local rc=0
    env CLAUDE_CONFIG_DIR="$dir" CLAUDE_SECURESTORAGE_CONFIG_DIR="$dir" claude "$@" || rc=$?
    # Deliberately NOT exec'd: the session refreshes into its own Keychain item and
    # the CLI's composite store deletes the plaintext copy once it does, so we have
    # to outlive the session to bring the newer credential back.
    sync_profile_creds_from_keychain "$name" || true
    return $rc
  fi

  # Shared scope, and every non-macOS run: exec's, so no wrapper process is left
  # behind and signals/exit codes/TTY behave exactly as for a bare `claude`.
  if keychain_available; then
    exec env CLAUDE_CONFIG_DIR="$dir" CLAUDE_SECURESTORAGE_CONFIG_DIR="" claude "$@"
  fi
  exec env CLAUDE_CONFIG_DIR="$dir" claude "$@"
}

# ── Menu data + rendering ─────────────────────────────────────────────────────
build_profile_meta() {
  P_EMAIL=(); P_ORG=(); P_SUB=(); P_U5=(); P_U7=(); P_UTS=()
  local i n meta e o s u5 u7 uts
  for i in "${!PROFILES[@]}"; do
    n="${PROFILES[$i]}"
    meta="$(profile_meta "$n" 2>/dev/null || true)"
    IFS=$'\t' read -r e o s <<< "$meta"
    P_EMAIL[i]="${e:-}"; P_ORG[i]="${o:-}"; P_SUB[i]="${s:-}"
    RU5=""; RU7=""; RUTS=""
    read_usage_cache "$n" || true
    P_U5[i]="${RU5:-}"; P_U7[i]="${RU7:-}"; P_UTS[i]="${RUTS:-}"
  done
}

# Build a profile row BODY (no left marker) in both plain and coloured forms into
# globals ROW_BODY_PLAIN / ROW_BODY_COLOR. Marker (2 cols) is added by the caller,
# so `width` here is the space AFTER the marker.
build_profile_row() {
  local idx="$1" width="$2"
  local name="${PROFILES[$idx]}"
  local email="${P_EMAIL[$idx]}" org="${P_ORG[$idx]}"
  local u5="${P_U5[$idx]}" u7="${P_U7[$idx]}" uts="${P_UTS[$idx]}"

  local name_w=14

  # Usage segment. Every field is a FIXED width so the 5h/7d columns line up
  # row-to-row and the block sits flush against the right edge of the card, no
  # matter how long each profile name / identity is. Layout (36 cols):
  #   5h ████  NN%   (12)  ·  gap (2)  ·  7d ████  NN%   (12)  ·  gap (2)  ·  age (8)
  local usage_w=36
  local usage_plain="" usage_color="" show_usage=false
  if [[ -n "$u5" || -n "$u7" ]] && (( width >= 70 )); then
    show_usage=true
    local w5p w5c w7p w7c age_p age_c
    if [[ -n "$u5" ]]; then
      w5p="$(printf '5h %s %3s%%' "$(bar_plain "$u5" 4)" "$u5")"
      w5c="${C_MUTED}5h${C_RESET} $(render_bar "$u5" 4 "$(sem_color "$u5")") $(sem_color "$u5")$(printf '%3s' "$u5")%${C_RESET}"
    else
      w5p="$(printf '%12s' '')"; w5c="$w5p"
    fi
    if [[ -n "$u7" ]]; then
      w7p="$(printf '7d %s %3s%%' "$(bar_plain "$u7" 4)" "$u7")"
      w7c="${C_MUTED}7d${C_RESET} $(render_bar "$u7" 4 "$(sem_color "$u7")") $(sem_color "$u7")$(printf '%3s' "$u7")%${C_RESET}"
    else
      w7p="$(printf '%12s' '')"; w7c="$w7p"
    fi
    # Cache age — staleness matters when picking a failover target.
    if [[ -n "$uts" && "$uts" =~ ^[0-9]+$ ]]; then
      local age; age="$(fmt_age "$uts")"
      age_p="$(printf '%-8s' "$age")"
      age_c="${C_DIM}${age_p}${C_RESET}"
    else
      age_p="$(printf '%8s' '')"; age_c="$age_p"
    fi
    usage_plain="${w5p}  ${w7p}  ${age_p}"
    usage_color="${w5c}  ${w7c}  ${age_c}"
  fi

  # Identity: "email · org", truncated to whatever space is left.
  local ident=""
  if [[ -n "$email" ]]; then
    ident="$email"
    [[ -n "$org" ]] && ident+=" $GLYPH_DOT $org"
  else
    ident="(no identity saved)"
  fi

  # Column budget: name_w + gap(2) + ident + gap(3) + usage(fixed). ident is PADDED
  # to its full width (not just truncated) so the usage block always starts at the
  # same column and ends flush at the card's right edge.
  local usage_cols=0
  [[ "$show_usage" == true ]] && usage_cols=$(( usage_w + 3 ))
  local ident_w=$(( width - name_w - 2 - usage_cols ))
  if (( ident_w < 6 )); then
    ident_w=$(( width - name_w - 2 )); show_usage=false
  fi
  local ident_plain
  ident_plain="$(pad_to "$ident_w" "$ident")"

  local name_plain
  name_plain="$(pad_to "$name_w" "$name")"

  ROW_BODY_PLAIN="${name_plain}  ${ident_plain}"
  [[ "$show_usage" == true ]] && ROW_BODY_PLAIN+="   ${usage_plain}"

  local ident_c="${C_DIM}${ident_plain}${C_RESET}"
  ROW_BODY_COLOR="${C_BOLD}${name_plain}${C_RESET}  ${ident_c}"
  [[ "$show_usage" == true ]] && ROW_BODY_COLOR+="   ${usage_color}"
  return 0
}

render_menu() {
  local active_profile="$1"
  local selected_index="$2"
  local profile_count="$3"

  local cols card
  cols="$(term_cols)"
  card=$(( cols - 4 ))
  (( card > 92 )) && card=92
  (( card < 40 )) && card=40

  local rule=""
  local i
  for (( i = 0; i < card; i++ )); do rule+="─"; done

  hide_cursor

  local out=""
  local nl=$'\n'
  local clr=$'\033[K'          # clear-to-EOL erases stale glyphs on shrink
  local body_w=$(( card - 2 )) # width available after the 2-col marker
  add() { out+="$1$clr$nl"; }

  # A selectable line: pointer marker when selected, else the given (coloured)
  # marker; body filled to the card width under a solid accent bar when selected.
  emit_line() {
    local selected="$1" marker_color="$2" body_plain="$3" body_color="$4"
    if [[ "$selected" == true ]]; then
      add "  ${C_SEL}$(pad_to "$card" "${GLYPH_POINTER} ${body_plain}")${C_RESET}"
    else
      add "  ${marker_color}${body_color}"
    fi
  }

  add ""
  add "  ${C_TITLE}Claude account switcher${C_RESET}"
  add "  ${C_MUTED}${PROFILE_ROOT}${C_RESET}   ${C_MUTED}active:${C_RESET} ${C_ACCENT}${active_profile:-none}${C_RESET}"
  add "  ${C_RULE}${rule}${C_RESET}"
  add ""

  local add_idx=$(( profile_count ))
  local quit_idx=$(( profile_count + 1 ))

  if (( profile_count > 0 )); then
    add "  ${C_MUTED}PROFILES${C_RESET}"
    for (( i = 0; i < profile_count; i++ )); do
      build_profile_row "$i" "$body_w"
      local mk="  "
      [[ "${PROFILES[$i]}" == "$active_profile" ]] && mk="${C_ACTIVE}${GLYPH_ACTIVE}${C_RESET} "
      local sel=false
      (( i == selected_index )) && sel=true
      emit_line "$sel" "$mk" "$ROW_BODY_PLAIN" "$ROW_BODY_COLOR"
    done
    add ""
  fi

  add "  ${C_MUTED}ACTIONS${C_RESET}"
  local add_sel=false quit_sel=false
  (( selected_index == add_idx )) && add_sel=true
  (( selected_index == quit_idx )) && quit_sel=true
  emit_line "$add_sel" "${C_ACCENT}+${C_RESET} " "Add a new profile" "Add a new profile"
  emit_line "$quit_sel" "${C_MUTED}⏻${C_RESET} " "Quit" "Quit"

  add ""
  add "  ${C_RULE}${rule}${C_RESET}"
  # Config-dir path of the selected profile — copy it into T3 as CLAUDE_CONFIG_DIR.
  if (( profile_count > 0 && selected_index < profile_count )); then
    add "  ${C_MUTED}config dir:${C_RESET} ${C_ACCENT}${PROFILE_ROOT}/${PROFILES[$selected_index]}${C_RESET}"
  fi
  local keybar="  ${C_KEY}↑↓${C_RESET}${C_MUTED} move   ${C_RESET}${C_KEY}⏎${C_RESET}${C_MUTED} select   ${C_RESET}"
  (( profile_count > 0 )) && keybar+="${C_KEY}o${C_RESET}${C_MUTED} open   ${C_RESET}"
  (( profile_count > 0 )) && keybar+="${C_KEY}r${C_RESET}${C_MUTED} refresh usage   ${C_RESET}"
  (( profile_count > 0 )) && keybar+="${C_KEY}d${C_RESET}${C_MUTED} remove   ${C_RESET}"
  keybar+="${C_KEY}a${C_RESET}${C_MUTED} add   ${C_RESET}${C_KEY}q${C_RESET}${C_MUTED} quit${C_RESET}"
  add "$keybar"

  # One write, from home, clearing anything below the frame — no full-screen flash.
  printf '\033[H%s\033[J' "$out"
  unset -f add
  unset -f emit_line
}

# Read one key (or a full arrow-key escape sequence) into the variable NAMED by $1.
# Uses `printf -v` rather than a bash-4.3 `local -n` nameref so it runs on bash 3.2
# (macOS) too; dynamic scoping means the caller's local is visible to set here.
read_key() {
  local __out="$1"
  local char
  local seq1
  local seq2
  local nl=$'\n'

  if ! IFS= read -r -s -n 1 char; then
    printf -v "$__out" '%s' ""
    return 1
  fi

  if [[ -z "$char" ]]; then
    printf -v "$__out" '%s' "$nl"
    return 0
  fi

  if [[ "$char" == $'\n' || "$char" == $'\r' ]]; then
    printf -v "$__out" '%s' "$nl"
    return 0
  fi

  if [[ "$char" == $'\e' ]]; then
    if IFS= read -r -s -n 1 -t "$ESC_SEQ_TIMEOUT" seq1; then
      case "$seq1" in
        '['|'O')
          if IFS= read -r -s -n 1 -t "$ESC_SEQ_TIMEOUT" seq2; then
            case "$seq2" in
              A|B|C|D)
                printf -v "$__out" '%s' "$char$seq1$seq2"
                ;;
              *)
                printf -v "$__out" '%s' "$char"
                ;;
            esac
          else
            printf -v "$__out" '%s' "$char"
          fi
          ;;
        *)
          printf -v "$__out" '%s' "$char"
          ;;
      esac
    else
      printf -v "$__out" '%s' "$char"
    fi
  else
    printf -v "$__out" '%s' "$char"
  fi

  return 0
}

show_menu() {
  enable_raw_mode

  PROFILES=()
  local profile
  while IFS= read -r profile; do
    [[ -n "$profile" ]] && PROFILES+=("$profile")
  done < <(list_profiles)

  build_profile_meta

  local active_profile
  active_profile="$(get_active_profile || true)"

  local selected_index=0
  local profile_count=${#PROFILES[@]}

  if (( profile_count > 0 )); then
    for i in "${!PROFILES[@]}"; do
      if [[ "${PROFILES[$i]}" == "$active_profile" ]]; then
        selected_index="$i"
        break
      fi
    done
  fi

  enter_alt_screen
  clear_screen

  local add_idx=$(( profile_count ))
  local quit_idx=$(( profile_count + 1 ))

  activate_selected() {
    local sel="${PROFILES[$selected_index]}"
    disable_raw_mode
    leave_alt_screen
    activate_profile "$sel"
    echo
    echo "You can now run: claude auth status  (or just use: claude)"
  }

  while true; do
    render_menu "$active_profile" "$selected_index" "$profile_count"

    local key
    if ! read_key key; then
      quit_program
      return 0
    fi

    case "$key" in
      $'\e')
        quit_program
        ;;
      $'\e[A'|$'\eOA')
        if (( profile_count > 0 )); then
          if (( selected_index == 0 )); then
            selected_index=$(( profile_count + 1 ))
          elif (( selected_index == profile_count )); then
            selected_index=$(( profile_count - 1 ))
          else
            selected_index=$(( selected_index - 1 ))
          fi
        else
          # No profiles: only "Add" (0) and "Quit" (1) — move relative + wrap.
          selected_index=$(( (selected_index + 1) % 2 ))
        fi
        ;;
      $'\e[B'|$'\eOB')
        if (( profile_count > 0 )); then
          if (( selected_index == profile_count + 1 )); then
            selected_index=0
          elif (( selected_index == profile_count - 1 )); then
            selected_index=$(( profile_count ))
          else
            selected_index=$(( selected_index + 1 ))
          fi
        else
          selected_index=$(( (selected_index + 1) % 2 ))
        fi
        ;;
      r|R)
        # Refresh the selected profile's usage on demand. refresh_profile_usage
        # sources a working token (live creds for the active profile, else a CLI
        # token refresh) so BOTH the 5h and 7d windows actually update.
        if (( profile_count > 0 && selected_index < profile_count )); then
          local rname="${PROFILES[$selected_index]}"
          render_menu "$active_profile" "$selected_index" "$profile_count"
          printf '\r  %s⟳ refreshing %s…%s' "$C_ACCENT" "$rname" "$C_RESET"
          local refresh_ok=true
          refresh_profile_usage "$rname" || refresh_ok=false
          # Reload the cache into the in-memory arrays so the row updates.
          RU5=""; RU7=""; RUTS=""
          read_usage_cache "$rname" || true
          P_U5[selected_index]="${RU5:-}"
          P_U7[selected_index]="${RU7:-}"
          P_UTS[selected_index]="${RUTS:-}"
          if [[ "$refresh_ok" != true ]]; then
            printf '\r  %s⚠ could not refresh %s (sign in again to renew its token)%s%*s' \
              "$C_AMBER" "$rname" "$C_RESET" 12 ''
            sleep 1.8
          fi
        fi
        ;;
      o|O)
        # Open a session in the selected profile WITHOUT switching the global
        # account. run_profile exec's, so hand the real terminal back first —
        # otherwise claude would inherit raw mode and the alt screen.
        if (( profile_count > 0 && selected_index < profile_count )); then
          local oname="${PROFILES[$selected_index]}"
          disable_raw_mode
          leave_alt_screen
          show_cursor
          # Only returns on failure (bad profile / unrenewable token / declined
          # merge); on success it has already replaced this process with claude.
          run_profile "$oname" || return 1
          return 0
        fi
        ;;
      d|D)
        # Remove the selected profile (only when a profile row is selected).
        if (( profile_count > 0 && selected_index < profile_count )); then
          local dname="${PROFILES[$selected_index]}"
          render_menu "$active_profile" "$selected_index" "$profile_count"
          local extra=""
          [[ "$dname" == "$active_profile" ]] && extra=" (active — your live session stays signed in)"
          printf '\r  %sRemove %s%s? Deletes its stored credentials. [y/N]%s ' \
            "$C_AMBER" "$dname" "$extra" "$C_RESET"
          local dk; read_key dk || dk=""
          if [[ "$dk" == "y" || "$dk" == "Y" ]]; then
            remove_profile "$dname" || true
            # Rebuild the in-memory profile list + indices to reflect the deletion.
            PROFILES=()
            local p
            while IFS= read -r p; do [[ -n "$p" ]] && PROFILES+=("$p"); done < <(list_profiles)
            build_profile_meta
            active_profile="$(get_active_profile || true)"
            profile_count=${#PROFILES[@]}
            add_idx=$(( profile_count ))
            quit_idx=$(( profile_count + 1 ))
            # Keep the cursor on a real profile row when one still exists.
            if (( profile_count > 0 && selected_index >= profile_count )); then
              selected_index=$(( profile_count - 1 ))
            fi
            (( selected_index > quit_idx )) && selected_index=$quit_idx
            (( selected_index < 0 )) && selected_index=0
            clear_screen
          fi
        fi
        ;;
      a|A)
        if add_new_profile; then
          return 0
        fi
        # Cancelled — rebuild the alt-screen menu state and continue.
        enable_raw_mode
        enter_alt_screen
        clear_screen
        continue
        ;;
      q|Q)
        quit_program
        ;;
      $'\n'|$'\r')
        if (( profile_count > 0 && selected_index < profile_count )); then
          activate_selected
          return 0
        elif (( selected_index == add_idx )); then
          if add_new_profile; then
            return 0
          fi
          enable_raw_mode
          enter_alt_screen
          clear_screen
          continue
        elif (( selected_index == quit_idx )); then
          quit_program
        fi
        ;;
    esac
  done
}

credentials_ready() {
  local creds_file="${1:-${CLAUDE_DIR}/.credentials.json}"
  [[ -f "$creds_file" ]] || return 1
  grep -q '"accessToken"' "$creds_file" 2>/dev/null
}

prompt_for_profile_name() {
  local prompt_text="$1"
  local __out="$2"   # name of the caller's output var (set via printf -v; bash-3.2 safe)
  local input=""
  local key

  show_cursor  # text entry — cursor is wanted here
  printf '%s' "$prompt_text"
  trap 'trap - INT; printf "\n"; printf -v "$__out" "%s" ""; return 3' INT

  while true; do
    if ! read_key key; then
      trap - INT
      printf -v "$__out" '%s' ""
      return 1
    fi

    case "$key" in
      $'\e')
        trap - INT
        printf '\n'
        printf -v "$__out" '%s' ""
        return 2
        ;;
      $'\n'|$'\r')
        trap - INT
        printf '\n'
        printf -v "$__out" '%s' "$input"
        return 0
        ;;
      $'\177'|$'\b')
        if (( ${#input} > 0 )); then
          input="${input%?}"
          printf '\b \b'
        fi
        ;;
      *)
        # Only accept a single printable char. Arrow keys etc. arrive as
        # multi-char escape sequences (e.g. $'\e[C') — ignore them so they can't
        # move the cursor over the prompt or land in the name.
        if (( ${#key} == 1 )) && [[ "$key" =~ [[:print:]] ]]; then
          input+="$key"
          printf '%s' "$key"
        fi
        ;;
    esac
  done
}

add_new_profile() {
  local new_name=""
  local prompt_status

  clear_screen
  hide_cursor
  printf '  %sAdd a new profile%s\n\n' "$C_TITLE" "$C_RESET"
  prompt_for_profile_name "  ${C_ACCENT}New profile name${C_RESET} ${C_MUTED}›${C_RESET} " new_name
  prompt_status=$?

  case "$prompt_status" in
    1|2|3)
      printf '\n'
      return 1
      ;;
  esac

  new_name="$(sanitize_profile_name "$new_name")"

  if [[ -d "$PROFILE_ROOT/$new_name" ]]; then
    local confirm_key
    printf "\n  %sProfile '%s' already exists. Overwrite it?%s %s[y/N]%s " \
      "$C_AMBER" "$new_name" "$C_RESET" "$C_MUTED" "$C_RESET"
    read_key confirm_key || confirm_key=""
    printf '\n'
    if [[ "$confirm_key" != "y" && "$confirm_key" != "Y" ]]; then
      echo "  Cancelled."
      return 1
    fi
  fi

  # Login is interactive, so hand the real terminal back before launching it. We do
  # NOT clear the screen here: `claude auth login` scrolls the terminal (browser URL,
  # paste-code prompt), and a later \033[2J would clear relative to the scrolled
  # viewport, stranding output at an odd offset. Instead everything below flows as
  # normal inline output so the shell prompt lands cleanly after the summary.
  disable_raw_mode
  leave_alt_screen
  printf '\n%sCreating profile:%s %s%s%s\n\n' "$C_MUTED" "$C_RESET" "$C_BOLD" "$new_name" "$C_RESET"

  local target_dir="$PROFILE_ROOT/$new_name"
  local pre_existed=true
  [[ -d "$target_dir" ]] || pre_existed=false
  mkdir -p "$target_dir"
  chmod 700 "$target_dir" 2>/dev/null || true

  # Log in DIRECTLY into the profile's own config dir. CLAUDE_CONFIG_DIR isolates
  # the whole login: credentials + identity are written straight into the dir and
  # the global ~/.claude session is never touched — so no logout / backup / restore
  # dance is needed, and the dir is immediately usable as a config dir (e.g. by T3).
  echo "Starting Claude login (isolated to this profile)..."
  echo "Complete the sign-in in your browser or terminal prompt."
  echo

  # Log in, then confirm credentials were captured. On macOS the freshly minted
  # token lands only in the login Keychain — CLAUDE_CONFIG_DIR does not redirect it —
  # so materialize it into the profile dir before the check. Otherwise a perfectly
  # good sign-in (e.g. an auto-completed browser session) reads as failure and the
  # profile is discarded.
  local login_ok=false
  if CLAUDE_CONFIG_DIR="$target_dir" claude auth login; then
    materialize_profile_credentials "$target_dir" || true
    credentials_ready "$target_dir/.credentials.json" && login_ok=true
  fi
  if [[ "$login_ok" == true ]]; then
    chmod 600 "$target_dir/.credentials.json" 2>/dev/null || true
    [[ -f "$target_dir/.claude.json" ]] && chmod 600 "$target_dir/.claude.json" 2>/dev/null || true
    # A fresh login leaves onboarding "incomplete"; stamp it so the dir is usable
    # directly as CLAUDE_CONFIG_DIR without re-prompting login.
    normalize_profile_identity "$new_name"
    # Wire it for shared sessions now, so `claudius run <name>` is usable
    # immediately. "auto" because anything in this dir is login scaffolding this
    # command just produced — there is no pre-existing user data to ask about.
    wire_profile_sharing "$new_name" "$( [[ "$pre_existed" == true ]] && printf 'true' || printf 'auto')" || true
    merge_profile_settings "$new_name" || true
    sync_profile_projects_key "$new_name" || true
    # Separator only — no screen clear (see note above). Summary flows inline.
    printf '\n%s%s%s\n' "$C_RULE" "────────────────────────────────────────" "$C_RESET"
    # Also make it the active global account for bare `claude` (saves the previous).
    activate_profile "$new_name"
    printf '%s✓%s Created profile %s%s%s.\n' \
      "$C_GREEN" "$C_RESET" "$C_BOLD" "$new_name" "$C_RESET"
    return 0
  fi

  # Sign-in didn't complete — nothing global was touched. Remove the dir only if we
  # created it here (don't delete a pre-existing profile the user chose to overwrite).
  if [[ "$pre_existed" == false ]]; then
    rm -rf "$target_dir"
  fi
  echo >&2
  echo "Claude login did not complete; profile '$new_name' was not created." >&2
  exit 1
}

# ── CLI subcommands ───────────────────────────────────────────────────────────
# Emit a JSON array of every stored profile with cached usage + active flag. This
# is the stable contract the dashboard/GUI consumes:
#   [{name, email, org, sub, active, u5, u7, uts}]
# u5/u7/uts are null when there is no cache (or that window is missing). Read-only:
# it never probes the API — it only reflects the on-disk .usage cache.
list_profiles_json() {
  local active; active="$(get_active_profile || true)"
  ruby - "$PROFILE_ROOT" "$active" <<'RB'
require 'json'
root = ARGV[0]
active = ARGV[1].to_s
out = []
(Dir.exist?(root) ? Dir.children(root) : []).sort.each do |name|
  next if name.start_with?('.')
  dir = File.join(root, name)
  next unless File.directory?(dir)
  email = org = sub = ""
  id_path = File.join(dir, ".claude.json")
  id_path = File.join(dir, "claude.json") unless File.exist?(id_path)
  begin
    j = JSON.parse(File.read(id_path))
    acc = j["oauthAccount"] || {}
    email = acc["emailAddress"] || ""
    org = acc["organizationName"] || ""
  rescue
  end
  # `expired` describes the credential STORED in the profile: no file, no token,
  # or an expiry already past (same 60s skew as token_expired, so the two never
  # disagree by a hair). It is what the page offers "sign in again" on — an
  # expired stored credential may still be renewable from its refresh token, so
  # this is an invitation, not a verdict, and refresh stays the first thing to
  # try. On macOS the live account's token is in the Keychain and its file can
  # lag behind it; that case is untested here and would read as expired early.
  expired = true
  begin
    c = JSON.parse(File.read(File.join(dir, ".credentials.json")))
    oauth = c["claudeAiOauth"] || {}
    sub = oauth["subscriptionType"] || ""
    exp = oauth["expiresAt"]
    expired = !(oauth["accessToken"].to_s != "" && exp && exp / 1000.0 > Time.now.to_f + 60)
  rescue
  end
  u5 = u7 = uts = r5 = r7 = nil
  begin
    parts = File.read(File.join(dir, ".usage")).strip.split(/\s+/)
    if parts.length >= 3
      u5 = parts[0] == "-" ? nil : parts[0].to_i
      u7 = parts[1] == "-" ? nil : parts[1].to_i
      uts = parts[2].to_i
      # r5/r7 (reset epochs) are optional trailing fields on newer caches.
      r5 = parts[3].to_i if parts[3] && parts[3] != "-"
      r7 = parts[4].to_i if parts[4] && parts[4] != "-"
    end
  rescue
  end
  out << {
    "name" => name, "email" => email, "org" => org, "sub" => sub,
    "active" => (name == active),
    "u5" => u5, "u7" => u7, "uts" => uts, "r5" => r5, "r7" => r7,
    "expired" => expired
  }
end
puts JSON.generate(out)
RB
}

# ── Usage history ─────────────────────────────────────────────────────────────
# `.usage` is one line, overwritten — a snapshot. `.usage.log` beside it is the
# same reading appended over time, which is what makes a burn rate and a
# projection possible. It costs no API calls: the status line is handed this
# session's live limits for free on every render, and both it and fetch_usage
# append there (see the appenders — they only ever add one line).
#
# So the shape of the file is decided HERE, in one place: everything from the
# last 6h at full resolution (the 5h window reads off that), one sample per 15
# minutes before it, nothing past 8 days. Pruning rewrites only when the file
# has grown past PRUNE_AT lines, so the common read does no writing at all.
#
# Emits, per profile:
#   {name, n, first, last, rate5, eta5, rate7, eta7, samples:[[ts,u5,u7],…]}
# rate is % per hour over the CURRENT window and null when there is too little
# history to say. eta is the epoch utilization reaches 100% at that rate, and is
# null both when the rate is unknown and when the ceiling lands after the window
# resets — i.e. null means "nothing to warn about", not "no data".
# points 0 omits the samples array entirely (a summary-only read).
usage_history_json() {
  local points="${1:-48}" only="${2:-}"
  ruby - "$PROFILE_ROOT" "$points" "$only" <<'RB'
require 'json'

root, points, only = ARGV[0], ARGV[1].to_i, ARGV[2].to_s
FINE     = 6 * 3600      # keep every sample this recent
COARSE   = 900           # older than FINE: at most one sample per 15 minutes
KEEP     = 8 * 86_400    # 7d window plus a day of margin; older is dropped
PRUNE_AT = 1500          # lines before a rewrite earns its cost
now = Time.now.to_i

# A sample is "ts u5 u7 r5 r7" with "-" for a missing field, same placeholder
# discipline as .usage. Anything unparseable is skipped rather than fatal — a
# torn line from a killed append must not take the whole history with it.
def parse(path)
  rows = []
  File.foreach(path) do |line|
    f = line.split
    next if f.length < 3
    ts = f[0].to_i
    next if ts <= 0
    num = lambda { |x| (x.nil? || x == '-') ? nil : x.to_i }
    rows << [ts, num.call(f[1]), num.call(f[2]), num.call(f[3]), num.call(f[4])]
  end
  rows.sort_by! { |r| r[0] }
  rows
rescue StandardError
  []
end

def thin(rows, now)
  seen = {}
  rows.select do |r|
    if now - r[0] > KEEP           then false
    elsif now - r[0] <= FINE       then true
    else
      b = r[0] / COARSE
      seen[b] ? false : (seen[b] = true)
    end
  end
end

# % per hour. Samples are segmented by their reset epoch, which sits still inside
# a window and jumps when the window rolls — so it identifies the current window
# exactly, with no need to guess from a drop in utilization. Measured over the
# most recent `pref` seconds when that spans enough to mean anything, otherwise
# over the whole window; nil when even that is too short to divide by.
def rate_of(rows, ui, ri, reset, pref, min_span)
  cur = rows.select { |r| r[ui] }
  cur = cur.select { |r| r[ri] == reset } if reset
  return nil if cur.length < 2
  last = cur.last
  win = cur.select { |r| last[0] - r[0] <= pref }
  win = cur if win.length < 2 || last[0] - win.first[0] < min_span
  dt = last[0] - win.first[0]
  return nil if win.length < 2 || dt < min_span
  ((last[ui] - win.first[ui]) * 3600.0 / dt).round(2)
end

# Where that rate meets 100%, projected from the last sample. A rate at or below
# a trickle is not a trend worth extrapolating, and a ceiling that lands after
# the window clears is not a ceiling you will hit.
def eta_of(rows, ui, rate, reset)
  return nil unless rate && rate > 0.5
  last = rows.select { |r| r[ui] }.last
  return nil unless last
  secs = ((100 - last[ui]) / rate * 3600).round
  return nil if secs <= 0
  t = last[0] + secs
  (reset && t >= reset) ? nil : t
end

# Evenly spaced by index, first and last always kept — enough for a sparkline
# without shipping a week of samples to draw forty pixels.
def pick(rows, n)
  return rows if rows.length <= n
  (0...n).map { |i| rows[(i * (rows.length - 1).to_f / (n - 1)).round] }.uniq
end

names = Dir.exist?(root) ? Dir.children(root).sort : []
names = names.select { |n| n == only } unless only.empty?
out = []
names.each do |name|
  next if name.start_with?('.')
  dir = File.join(root, name)
  next unless File.directory?(dir)
  path = File.join(dir, '.usage.log')

  rows = File.exist?(path) ? parse(path) : []
  if rows.length > PRUNE_AT
    kept = thin(rows, now)
    if kept.length < rows.length
      begin
        tmp = path + '.tmp'
        File.open(tmp, 'w') do |f|
          kept.each do |r|
            f.write("#{r[0]} #{r[1] || '-'} #{r[2] || '-'} #{r[3] || '-'} #{r[4] || '-'}\n")
          end
        end
        File.chmod(0o600, tmp)
        File.rename(tmp, path)
        rows = kept
      rescue StandardError
        rows = kept   # the read still uses the thinned view even if the write failed
      end
    end
  end

  # The reset epochs come from the samples themselves, not from .usage, so the
  # rate and the window it is measured over can never be out of step.
  r5 = rows.reverse.find { |r| r[3] }&.at(3)
  r7 = rows.reverse.find { |r| r[4] }&.at(4)
  rate5 = rate_of(rows, 1, 3, r5, 45 * 60, 10 * 60)
  rate7 = rate_of(rows, 2, 4, r7, 12 * 3600, 30 * 60)

  row = {
    'name' => name, 'n' => rows.length,
    'first' => rows.empty? ? nil : rows.first[0],
    'last'  => rows.empty? ? nil : rows.last[0],
    'rate5' => rate5, 'eta5' => eta_of(rows, 1, rate5, r5),
    'rate7' => rate7, 'eta7' => eta_of(rows, 2, rate7, r7)
  }
  row['samples'] = pick(rows, points).map { |r| [r[0], r[1], r[2]] } if points > 0
  out << row
end
puts JSON.generate(out)
RB
}

# ── Which account next ────────────────────────────────────────────────────────
# Ranks the profiles by how much room they have left and prints one name. The
# rules, in order, and why each is there rather than something cleverer:
#
#   1. A window at 100% is a wall, so a profile behind one is not a candidate.
#   2. Headroom is the SMALLER of the two windows' remaining room. 4% left on the
#      7d is 4% left, however empty the 5h looks.
#   3. Headroom is bucketed to 5 points before it is compared. Two accounts
#      within a few points of each other are not meaningfully different, and
#      pretending otherwise would let noise outvote the tie-breaks below.
#   4. A fresh reading beats a stale one. An hour-old number is a guess.
#   5. Then the idler account, by burn rate — the other one probably has a
#      session running in it right now.
#   6. Then the account already active, because not switching is free.
#
# An imminent reset is deliberately NOT credited as headroom: it would hand
# `claudius run "$(claudius next)"` an account that is still walled off for the
# next few minutes. When nothing is usable the answer is the wait, not a name.
next_json() {
  ruby - "$1" "$2" <<'RB'
require 'json'
profiles = (JSON.parse(ARGV[0].to_s) rescue [])
hist     = (JSON.parse(ARGV[1].to_s) rescue [])
rate = {}
hist.each { |h| rate[h['name']] = h }
now = Time.now.to_i
STALE = 3600
# A 7d reset is days away, where a bare clock time reads as today. Same rule as
# `history`: anything but today carries its date.
when_at = lambda do |ep|
  t = Time.at(ep)
  t.strftime(t.strftime('%F') == Time.now.strftime('%F') ? '%H:%M' : '%b %-d %H:%M')
end

rows = profiles.map do |p|
  u5, u7 = p['u5'], p['u7']
  h5 = u5.nil? ? nil : 100 - u5
  h7 = u7.nil? ? nil : 100 - u7
  head = [h5, h7].compact.min
  bind = (head && h5 == head) ? '5h' : '7d'
  walls = []
  walls << ['5h', p['r5']] if u5 && u5 >= 100
  walls << ['7d', p['r7']] if u7 && u7 >= 100
  stale = p['uts'].nil? || (now - p['uts']) > STALE
  h = rate[p['name']] || {}

  # Both windows have to clear, so the wait is the later of them.
  clear_at = walls.map { |_, ep| ep }.compact.max
  why =
    if !walls.empty?
      "at the #{walls.map(&:first).join(' + ')} limit" +
        (clear_at ? " · clears #{when_at.call(clear_at)}" : '')
    elsif head.nil?
      'no usage cached — needs a refresh'
    else
      s = "#{head}% left on the #{bind}"
      s += " · hits it ~#{when_at.call(h['eta5'])}" if bind == '5h' && h['eta5']
      s += ' · stale reading' if stale
      s
    end

  { 'name' => p['name'], 'active' => p['active'], 'u5' => u5, 'u7' => u7,
    'uts' => p['uts'], 'rate5' => h['rate5'], 'eta5' => h['eta5'],
    'headroom' => head, 'binding' => head.nil? ? nil : bind,
    'eligible' => walls.empty? && !head.nil?, 'stale' => stale,
    'clear_at' => clear_at, 'why' => why }
end

rows = rows.sort_by do |r|
  [r['eligible'] ? 0 : 1,
   r['headroom'].nil? ? 1 : 0,
   r['headroom'].nil? ? 0 : -(r['headroom'] / 5),
   r['stale'] ? 1 : 0,
   r['rate5'] || 0,
   r['active'] ? 0 : 1,
   r['name']]
end

first = rows.find { |r| r['eligible'] }
soonest = rows.select { |r| r['clear_at'] }.min_by { |r| r['clear_at'] }
puts JSON.generate(
  'pick' => first && first['name'],
  'reason' => first && first['why'],
  'blocked_until' => first ? nil : (soonest && soonest['clear_at']),
  'first_to_clear' => first ? nil : (soonest && soonest['name']),
  'ranked' => rows
)
RB
}

# ── Sessions ──────────────────────────────────────────────────────────────────
# The conversation pool. Because `run` symlinks ~/.claude/projects into every
# wired profile, sessions are NOT per-account: one pool, and any profile can
# resume any session. So this lists the pool once and leaves the choice of
# account to whoever resumes it.
#
# 461MB of transcripts here and single files past 30MB, so nothing whole-reads:
# the candidates are ranked by mtime first, then only the newest few are opened —
# a handful of head lines for the title, one 64KB tail seek for the last state.
# Subagent transcripts live deeper (…/<id>/subagents/agent-*.jsonl) and are not
# resumable sessions, so only the one-level-deep UUID files count.
sessions_json() {
  local limit="${1:-40}"
  ruby - "$CLAUDE_DIR/projects" "$limit" <<'RB'
require 'json'
root, limit = ARGV[0], ARGV[1].to_i
UUID = /\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.jsonl\z/
# Dir.home, not ENV['HOME'] directly, so a sandboxed HOME in the tests resolves
# the same way the rest of the script does.
HOME = Dir.home.chomp('/')

files = Dir.glob(File.join(root, '*', '*.jsonl')).select { |p| File.basename(p) =~ UUID }
# Rank before reading — mtime is a stat, the transcript body is not.
files = files.sort_by { |p| -(File.mtime(p).to_i) }
# limit 0 means the whole pool. It is a real request ("show me everything"), not a
# mistake, so it is honoured rather than clamped back to the default.
files = files.first(limit) if limit > 0

# The first complete JSON objects, giving up early: cwd/branch land within a few
# lines, a title may be on line 1, and the opening user turn is usually inside the
# first dozen. File-history snapshots are megabytes of embedded file content and
# never hold any of that, so they are skipped on length before being parsed.
# Reads until it has what it came for rather than a fixed number of lines: the
# opening user turn always precedes the first assistant reply, so an assistant
# entry means there is nothing left to find and scanning stops there. `want` is
# only the backstop for a transcript that never answers.
def head_objs(path, want = 120)
  out = []
  File.foreach(path) do |line|
    next if line.bytesize > 1_000_000
    o = (JSON.parse(line) rescue nil)
    next unless o
    out << o
    break if out.size >= want
    break if o['type'] == 'assistant' && out.any? { |h| h['type'] == 'user' }
  end
  out
rescue StandardError
  []
end

# Last complete objects without reading the file: seek to the final 64KB and drop
# the leading fragment, which is almost certainly half a line.
def tail_objs(path)
  size = File.size(path)
  buf = File.open(path, 'rb') { |io| io.seek([size - 65_536, 0].max); io.read }
  lines = buf.split("\n").reject(&:empty?)
  lines.shift if size > 65_536 && lines.size > 1
  lines.reverse.map { |l| JSON.parse(l) rescue nil }.compact
rescue StandardError
  []
end

def pick(objs, key)
  objs.each { |o| v = o[key]; return v if v.is_a?(String) && !v.empty? }
  nil
end

# A user turn's text, whether the content is a bare string or a block list.
def msg_text(obj)
  c = obj.dig('message', 'content')
  case c
  when String then c
  when Array
    c.select { |b| b.is_a?(Hash) && b['type'] == 'text' }.map { |b| b['text'] }.compact.join(' ')
  end
end

# Machinery the user never typed: the caveat Claude Code prepends to a resumed
# session, command stdout/stderr replayed back in, hook output, injected reminders.
WRAPPER = /\A\s*<\/?(?:local-command-caveat|local-command-stdout|local-command-stderr|
  system-reminder|user-prompt-submit-hook|ide[_-][a-z]+)[\s>\/]/x

# The opening of the conversation, as two separate answers because they are worth
# different amounts. Prose is what the session is *about*. A slash command is not
# prose — it arrives wrapped in <command-name> tags — but "/resume" still says more
# than nothing, so it comes back as a weaker second option rather than being
# dropped. Returns [prose, command], either or both possibly nil.
def first_prompt(objs)
  prose = nil
  cmd = nil
  objs.each do |o|
    next unless o['type'] == 'user' && o['isMeta'] != true && o.dig('message', 'role') == 'user'
    t = msg_text(o)
    next if t.nil? || t.strip.empty?
    if (m = t.match(%r{<command-name>\s*([^<]{1,60}?)\s*</command-name>}))
      unless cmd
        args = t[%r{<command-args>\s*([^<]{0,80}?)\s*</command-args>}, 1].to_s.strip
        cmd = args.empty? ? m[1].strip : "#{m[1].strip} #{args}"
      end
      next
    end
    next if t =~ WRAPPER
    prose = t
    break
  end
  [prose, cmd]
end

# Whatever reads best as a name, best source first. Also reports which source won,
# so the dashboard can show a title as a name but a prompt as something quoted —
# they are not the same kind of thing and shouldn't read alike.
def label_of(head, tail)
  prose, cmd = first_prompt(head)
  raw, src = [
    [pick(tail, 'aiTitle') || pick(head, 'aiTitle'), 'title'],
    [pick(tail, 'slug') || pick(head, 'slug'), 'slug'],
    [prose, 'prompt'],
    [pick(tail, 'lastPrompt') || pick(head, 'lastPrompt'), 'last'],
    [cmd, 'command'],
  ].find { |v, _| v.is_a?(String) && !v.strip.empty? }
  return [nil, nil] unless raw
  s = raw.tr("\n\r\t", '   ').gsub(/\s+/, ' ').strip
  s = s.tr('-', ' ') if src == 'slug' && s =~ /\A[a-z0-9-]+\z/   # slugs read better spaced
  return [nil, nil] if s.empty?
  [s.length > 72 ? s[0, 71] + '…' : s, src]
end

out = []
files.each do |path|
  head = head_objs(path)
  next if head.empty?
  # A subagent transcript that landed at session depth is still not resumable.
  next if head.any? { |o| o['isSidechain'] == true }
  tail = tail_objs(path)
  both = tail + head
  id = File.basename(path, '.jsonl')
  # cwd from the transcript, never decoded from the directory name — that
  # encoding replaces every '/' with '-' and cannot be reversed for a path
  # that legitimately contains a dash.
  dirkey = File.basename(File.dirname(path))
  # Which directory to cd into is not a free choice: `--resume` resolves a session
  # against the project directory Claude Code filed it under, which is exactly the
  # directory this transcript sits in. A session's cwd moves while it runs, so
  # neither the first nor the last one it mentions is reliably that directory — the
  # first misses a worktree entered mid-session, the last catches whatever scratch
  # subdirectory it wandered into. Both produced commands that run cleanly and find
  # no session.
  #
  # So the candidates are checked against the directory name instead. Encoding a
  # path into that name is exact (every '/' and '.' becomes '-'); only the reverse
  # is lossy, and the reverse is never attempted here.
  cands = (head + tail).map { |o| o['cwd'] }.compact.reject(&:empty?).uniq
  cwd = cands.find { |c| c.gsub(%r{[/.]}, '-') == dirkey } || cands.first
  label, lsrc = label_of(head, tail)
  # `exists` is the difference between a command that works and one that fails on
  # its first clause: a resume has to cd into the project, and directories get
  # deleted, renamed and moved out from under a transcript all the time. nil when
  # there is no cwd to check at all.
  # `short` is the same path written the way a person writes it, and it also
  # disambiguates the home directory itself, whose basename is a username and
  # reads exactly like a profile name in a narrow column.
  short = if cwd.nil? then nil
          elsif cwd == HOME then '~'
          elsif cwd.start_with?(HOME + '/') then '~' + cwd[HOME.length..]
          else cwd
          end
  out << {
    'id' => id,
    'cwd' => cwd,
    'short' => short,
    'exists' => cwd.nil? ? nil : File.directory?(cwd),
    'dirkey' => dirkey,
    'label' => label,
    'lsrc' => lsrc,
    'branch' => pick(both, 'gitBranch'),
    'mts' => File.mtime(path).to_i,
    'size' => File.size(path),
  }
end
puts JSON.generate(out)
RB
}

# claudius sessions [--json] [--limit N] — the resumable pool, newest first.
cmd_sessions() {
  local json=false limit=40
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)  json=true; shift ;;
      --limit) limit="${2:-40}"; shift 2 || shift ;;
      *) echo "usage: $(basename "$0") sessions [--json] [--limit N]" >&2; return 2 ;;
    esac
  done
  case "$limit" in ''|*[!0-9]*) limit=40 ;; esac

  if [[ "$json" == true ]]; then
    sessions_json "$limit"
    return 0
  fi

  local prog rows
  prog="$(basename "$0")"
  # Passed as an argument, not piped: `ruby -` takes its program from stdin, so a
  # heredoc here would sit where the piped JSON was supposed to be.
  rows="$(sessions_json "$limit")"
  ruby - "$prog" "$rows" <<'RB'
require 'json'
prog = ARGV[0]
rows = (JSON.parse(ARGV[1].to_s) rescue [])
if rows.empty?
  puts 'No sessions found in ~/.claude/projects.'
  exit 0
end
now = Time.now.to_i
age = lambda do |t|
  s = now - t
  return "#{s}s"            if s < 60
  return "#{s / 60}m"       if s < 3600
  return "#{s / 3600}h"     if s < 86_400
  "#{s / 86_400}d"
end
rows.each do |r|
  # Quoted when the label is someone's words rather than a name, same as the
  # dashboard — a first prompt shouldn't read as if Claude titled the session.
  quoted = %w[prompt last].include?(r['lsrc'])
  # Truncate before quoting, or the closing quote is what gets cut off.
  shown = (r['label'] || '(nothing was said)')[0, quoted ? 34 : 36]
  shown = %("#{shown}") if quoted
  # A missing directory is said out loud: the resume command starts with a cd, so
  # this row cannot be resumed as printed.
  where = r['short'] || r['cwd'] || r['dirkey']
  where += '  (directory is gone)' if r['exists'] == false
  puts format("%-6s  %-36s  %s", age.call(r['mts']), shown, where)
  weight = r['size'].to_i >= 1_048_576 ? format("  %dMB", r['size'].to_i / 1_048_576) : ''
  puts format("        %s%s%s", r['id'], r['branch'] ? "  [#{r['branch']}]" : '', weight)
end
puts
puts "resume one with:  cd <dir> && #{prog} run <profile> --resume <id>"
puts "                  (--limit 0 lists the whole pool)"
RB
}

cmd_list() {
  if [[ "${1:-}" == "--json" ]]; then
    list_profiles_json
    return 0
  fi
  local active; active="$(get_active_profile || true)"
  local n meta e o s
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    meta="$(profile_meta "$n" 2>/dev/null || true)"
    IFS=$'\t' read -r e o s <<< "$meta"
    RU5=""; RU7=""; RUTS=""
    read_usage_cache "$n" || true
    local mark="  "
    [[ "$n" == "$active" ]] && mark="${C_ACTIVE}${GLYPH_ACTIVE}${C_RESET} "
    local usage=""
    [[ -n "$RU5" ]] && usage+="5h ${RU5}%"
    [[ -n "$RU7" ]] && usage+="${usage:+  }7d ${RU7}%"
    printf '%s%s%-14s%s  %s%s%s   %s\n' \
      "$mark" "$C_BOLD" "$n" "$C_RESET" "$C_DIM" "${e:-(no identity)}${o:+ $GLYPH_DOT $o}" "$C_RESET" "$usage"
  done < <(list_profiles)
}

cmd_history() {
  local json=false points=48 name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)   json=true; shift ;;
      --points) points="${2:-48}"; shift 2 || shift ;;
      -*) echo "usage: $(basename "$0") history [profile] [--json] [--points N]" >&2; return 2 ;;
      *)  name="$1"; shift ;;
    esac
  done
  case "$points" in ''|*[!0-9]*) points=48 ;; esac
  [[ "$points" -gt 500 ]] && points=500
  # points 0 means "omit the samples array" — a summary-only shape that only makes
  # sense for --json. The printed report is largely its sparkline.
  [[ "$json" == true || "$points" -gt 0 ]] || points=48
  if [[ -n "$name" && ! -d "$PROFILE_ROOT/$name" ]]; then
    echo "Profile '$name' does not exist." >&2
    return 1
  fi

  if [[ "$json" == true ]]; then
    usage_history_json "$points" "$name"
    return 0
  fi

  local rows
  rows="$(usage_history_json "$points" "$name")"
  ruby - "$rows" <<'RB'
require 'json'
rows = (JSON.parse(ARGV[0].to_s) rescue [])
if rows.empty?
  puts 'No profiles found.'
  exit 0
end
BARS = %w[▁ ▂ ▃ ▄ ▅ ▆ ▇ █]
now = Time.now.to_i

# Fixed 0–100 scale, never auto-ranged: a sparkline that rescales itself makes a
# flat 3% week look identical to a flat 90% one, which is the opposite of the
# reading. Terminals get 24 columns of it at most.
spark = lambda do |vals|
  vals = vals.compact
  return '' if vals.length < 3
  vals = (0...24).map { |i| vals[(i * (vals.length - 1).to_f / 23).round] } if vals.length > 24
  vals.map { |v| BARS[[[v, 0].max, 100].min * (BARS.length - 1) / 100] }.join
end
span = lambda do |s|
  return "#{s / 86_400}d" if s >= 86_400
  return "#{s / 3600}h"   if s >= 3600
  "#{s / 60}m"
end
# A 7d projection can land days out, where a bare "17:56" says the wrong thing
# entirely — so anything other than today carries its date.
when_at = lambda do |ep|
  t = Time.at(ep)
  t.strftime(t.strftime('%F') == Time.now.strftime('%F') ? '%H:%M' : '%b %-d %H:%M')
end

rows.each do |r|
  puts r['name']
  samples = r['samples'] || []
  if samples.length < 2
    puts '    no history yet — it fills as the status line renders, at no API cost'
    puts
    next
  end
  [['5h', 1, 'rate5', 'eta5'], ['7d', 2, 'rate7', 'eta7']].each do |label, i, rk, ek|
    vals = samples.map { |s| s[i] }
    cur = vals.compact.last
    next unless cur
    rate = r[rk]
    trend = rate.nil? ? 'too little history' : format('%+.1f%%/h', rate)
    where = if r[ek]           then "→ 100% around #{when_at.call(r[ek])}"
            elsif rate.nil?    then ''
            elsif rate <= 0.5  then '→ holding steady'
            else                    '→ the window clears first'
            end
    puts format('    %-3s %3d%%  %-24s  %-11s %s', label, cur, spark.call(vals), trend, where)
  end
  puts format('    %d samples over %s', r['n'], span.call(now - r['first']))
  puts
end
RB
}

# The question the whole tool exists to answer, as one word on stdout, so it can
# be used directly:  claudius run "$(claudius next)"
cmd_next() {
  local json=false explain=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)    json=true; shift ;;
      --explain) explain=true; shift ;;
      *) echo "usage: $(basename "$0") next [--json] [--explain]" >&2; return 2 ;;
    esac
  done
  local profiles hist
  profiles="$(list_profiles_json)"
  hist="$(usage_history_json 0)"
  local out
  out="$(next_json "$profiles" "$hist")" || return 1
  if [[ "$json" == true ]]; then
    printf '%s\n' "$out"
    return 0
  fi
  ruby - "$out" "$explain" <<'RB'
require 'json'
d = (JSON.parse(ARGV[0].to_s) rescue {})
explain = ARGV[1] == 'true'
pick = d['pick']

unless explain
  if pick
    puts pick
    exit 0
  end
  # Nothing is usable. That is an answer, but not a name — say when it changes on
  # stderr so a `$(claudius next)` substitution stays empty rather than absorbing
  # the explanation.
  if d['blocked_until']
    # A 7d wall clears days out, where a bare clock time reads as tonight.
    t = Time.at(d['blocked_until'])
    same_day = t.strftime('%F') == Time.now.strftime('%F')
    warn "Every account is at a limit. The first to clear is #{d['first_to_clear']} " \
         "at #{t.strftime(same_day ? '%H:%M' : '%b %-d %H:%M')}."
  else
    warn 'No usable account: no usage has been read yet. Try `claudius refresh <profile>`.'
  end
  exit 1
end

rows = d['ranked'] || []
if rows.empty?
  puts 'No profiles found.'
  exit 0
end
puts format('  %-14s %5s %5s %9s  %s', '', '5h', '7d', 'burn', 'why')
rows.each do |r|
  mark = r['name'] == pick ? '→ ' : '  '
  pct = lambda { |v| v.nil? ? '  –' : format('%3d%%', v) }
  burn = r['rate5'].nil? ? '       –' : format('%+7.1f/h', r['rate5'])
  puts format('%s%-14s %5s %5s %9s  %s',
              mark, r['name'], pct.call(r['u5']), pct.call(r['u7']), burn, r['why'])
end
puts
puts(pick ? "→ #{pick}" : 'nothing usable right now')
RB
}

cmd_status() {
  if [[ "${1:-}" == "--json" ]]; then
    local active; active="$(get_active_profile || true)"
    local token limits
    token="$(get_access_token || true)"
    limits="$(fetch_usage "$token" "" 2>/dev/null || true)"
    ruby - "$active" "$limits" <<'RB'
require 'json'
puts JSON.generate("active" => (ARGV[0].to_s.empty? ? nil : ARGV[0]), "usage" => ARGV[1].to_s)
RB
    return 0
  fi
  local active; active="$(get_active_profile || true)"
  printf '%sactive:%s %s%s%s\n' "$C_MUTED" "$C_RESET" "$C_ACCENT" "${active:-none}" "$C_RESET"
  show_account_status "$active"
}

cmd_refresh() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: $(basename "$0") refresh <profile>" >&2
    return 2
  fi
  if [[ ! -d "$PROFILE_ROOT/$name" ]]; then
    echo "Profile '$name' does not exist." >&2
    return 1
  fi
  local ok=true
  refresh_profile_usage "$name" || ok=false
  RU5=""; RU7=""; RUTS=""
  read_usage_cache "$name" || true
  if [[ "$ok" == true ]]; then
    printf '%s✓%s refreshed %s%s%s  5h %s%%  7d %s%%\n' \
      "$C_GREEN" "$C_RESET" "$C_BOLD" "$name" "$C_RESET" "${RU5:-–}" "${RU7:-–}"
  else
    printf '%s⚠%s could not refresh %s — sign in again: %s%s relogin %s%s\n' \
      "$C_AMBER" "$C_RESET" "$name" "$C_DIM" "$(basename "$0")" "$name" "$C_RESET" >&2
    return 1
  fi
}

cmd_activate() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: $(basename "$0") activate <profile>" >&2
    return 2
  fi
  activate_profile "$name"
}

cmd_remove() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: $(basename "$0") remove <profile>" >&2
    return 2
  fi
  if [[ ! -d "$PROFILE_ROOT/$name" ]]; then
    echo "Profile '$name' does not exist." >&2
    return 1
  fi
  local active; active="$(get_active_profile || true)"
  local warn=""
  [[ "$active" == "$name" ]] && warn=" (currently active)"
  printf "%sRemove profile '%s'%s?%s This deletes its stored credentials. [y/N] " \
    "$C_AMBER" "$name" "$warn" "$C_RESET"
  local ans; IFS= read -r ans || ans=""
  if [[ "$ans" != "y" && "$ans" != "Y" ]]; then
    echo "Cancelled."
    return 1
  fi
  remove_profile "$name" || return 1
  printf '%s✓%s Removed profile %s%s%s.\n' "$C_GREEN" "$C_RESET" "$C_BOLD" "$name" "$C_RESET"
  if [[ "$active" == "$name" ]]; then
    printf '%s  Your live Claude session is unchanged — this only forgot the saved profile.%s\n' \
      "$C_MUTED" "$C_RESET"
  fi
}

# Minimal arrow-key picker over the stored profiles, for bare `claudius run`.
# Sets PICKED to the chosen name (empty when cancelled). Deliberately its own
# small frame rather than a mode bolted onto show_menu: the only action is "pick
# one", so none of the menu's activate/remove/add machinery applies.
PICKED=""
pick_profile() {
  local title="Run claude in which profile?"
  PICKED=""
  PROFILES=()
  local p
  while IFS= read -r p; do
    [[ -n "$p" ]] && PROFILES+=("$p")
  done < <(list_profiles)
  local count=${#PROFILES[@]}
  if (( count == 0 )); then
    echo "No profiles yet. Add one: $(basename "$0") add <name>" >&2
    return 1
  fi
  build_profile_meta

  local active; active="$(get_active_profile || true)"
  local sel=0 i
  for (( i = 0; i < count; i++ )); do
    if [[ "${PROFILES[$i]}" == "$active" ]]; then sel="$i"; break; fi
  done

  enable_raw_mode
  enter_alt_screen
  clear_screen

  local cols card body_w
  cols="$(term_cols)"
  card=$(( cols - 4 )); (( card > 92 )) && card=92; (( card < 40 )) && card=40
  body_w=$(( card - 2 ))

  local key out nl=$'\n' clr=$'\033[K'
  while true; do
    hide_cursor
    out=""
    out+="$clr$nl"
    out+="  ${C_TITLE}${title}${C_RESET}$clr$nl"
    out+="$clr$nl"
    for (( i = 0; i < count; i++ )); do
      build_profile_row "$i" "$body_w"
      if (( i == sel )); then
        out+="  ${C_SEL}$(pad_to "$card" "${GLYPH_POINTER} ${ROW_BODY_PLAIN}")${C_RESET}$clr$nl"
      else
        local mk="  "
        [[ "${PROFILES[$i]}" == "$active" ]] && mk="${C_ACTIVE}${GLYPH_ACTIVE}${C_RESET} "
        out+="  ${mk}${ROW_BODY_COLOR}$clr$nl"
      fi
    done
    out+="$clr$nl"
    out+="  ${C_KEY}↑↓${C_RESET}${C_MUTED} move   ${C_RESET}${C_KEY}⏎${C_RESET}${C_MUTED} run   ${C_RESET}${C_KEY}esc${C_RESET}${C_MUTED} cancel${C_RESET}$clr$nl"
    printf '\033[H%s\033[J' "$out"

    if ! read_key key; then
      disable_raw_mode; leave_alt_screen; show_cursor
      return 1
    fi
    case "$key" in
      $'\e'|q|Q)
        disable_raw_mode; leave_alt_screen; show_cursor
        return 1
        ;;
      $'\e[A'|$'\eOA') sel=$(( (sel + count - 1) % count )) ;;
      $'\e[B'|$'\eOB') sel=$(( (sel + 1) % count )) ;;
      $'\n'|$'\r')
        PICKED="${PROFILES[$sel]}"
        disable_raw_mode; leave_alt_screen; show_cursor
        return 0
        ;;
    esac
  done
}

# claudius run [<profile>] [claude args…]
# Everything after the profile name is passed to `claude` verbatim, so
# `claudius run work --model sonnet -p "hi"` works as expected. No flags of our
# own, deliberately: anything we invented here would collide with claude's.
cmd_run() {
  local name="${1:-}"
  if [[ -n "$name" ]]; then
    shift
  else
    # No profile given: pick one interactively (a tty is required for that).
    if ! { [[ -t 0 ]] && [[ -t 1 ]]; }; then
      echo "usage: $(basename "$0") run <profile> [claude args…]" >&2
      return 2
    fi
    pick_profile || return 1
    name="$PICKED"
    [[ -n "$name" ]] || return 1
  fi

  run_profile "$name" "$@"
}

# claudius link <profile> — (re)wire a profile for shared sessions without
# launching anything. Idempotent; useful to repair a profile or to opt an old one
# in ahead of time. Reports what it did rather than exec'ing claude.
cmd_link() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: $(basename "$0") link <profile>" >&2
    return 2
  fi
  if [[ ! -d "$PROFILE_ROOT/$name" ]]; then
    echo "Profile '$name' does not exist." >&2
    return 1
  fi
  normalize_profile_identity "$name"
  local interactive=true
  { [[ -t 0 ]] && [[ -t 1 ]]; } || interactive=false
  wire_profile_sharing "$name" "$interactive" || return 1
  merge_profile_settings "$name" || true
  sync_profile_projects_key "$name" || true
  local n_new=$(( ${#SHARE_PLAN_LINK[@]} + ${#SHARE_PLAN_RELINK[@]} + ${#SHARE_PLAN_MERGE[@]} ))
  if (( n_new > 0 )); then
    printf '%s✓%s Wired %s%s%s for shared sessions (%d linked).\n' \
      "$C_GREEN" "$C_RESET" "$C_BOLD" "$name" "$C_RESET" "$n_new"
  else
    printf '%s✓%s %s%s%s is already wired for shared sessions.\n' \
      "$C_GREEN" "$C_RESET" "$C_BOLD" "$name" "$C_RESET"
  fi
  printf '%s  run it with:%s %s run %s\n' "$C_MUTED" "$C_RESET" "$(basename "$0")" "$name"
}

# CLI add: interactive browser login, but plain terminal I/O (no alt-screen / raw
# mode). Accepts an optional name argument, otherwise prompts on the plain tty.
cmd_add() {
  # --no-activate leaves the global account alone. The terminal flow ends by
  # switching to the profile you just made, which is nearly always what you meant
  # there; on the dashboard it would mean the hero swapping under you when you
  # asked to ADD an account, so the sidecar passes this and offers the switch as a
  # choice instead.
  local new_name="" do_activate=true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-activate) do_activate=false; shift ;;
      -*) echo "usage: $(basename "$0") add [name] [--no-activate]" >&2; return 2 ;;
      *)  [[ -z "$new_name" ]] && new_name="$1"; shift ;;
    esac
  done
  if [[ -z "$new_name" ]]; then
    printf '%sNew profile name%s ' "$C_ACCENT" "$C_RESET"
    IFS= read -r new_name || return 1
  fi
  new_name="$(sanitize_profile_name "$new_name")"

  local target_dir="$PROFILE_ROOT/$new_name"
  local pre_existed=true
  if [[ -d "$target_dir" ]]; then
    printf "%sProfile '%s' already exists. Overwrite it?%s [y/N] " \
      "$C_AMBER" "$new_name" "$C_RESET"
    local ans; IFS= read -r ans || ans=""
    if [[ "$ans" != "y" && "$ans" != "Y" ]]; then
      echo "Cancelled."
      return 1
    fi
  else
    pre_existed=false
  fi

  mkdir -p "$target_dir"
  chmod 700 "$target_dir" 2>/dev/null || true

  printf '\n%sCreating profile:%s %s%s%s\n\n' "$C_MUTED" "$C_RESET" "$C_BOLD" "$new_name" "$C_RESET"
  echo "Starting Claude login (isolated to this profile)..."
  echo "Complete the sign-in in your browser or terminal prompt."
  echo

  # See add_new_profile: on macOS the token lands only in the Keychain, so pull it
  # into the profile dir before treating the sign-in as complete.
  local login_ok=false
  if CLAUDE_CONFIG_DIR="$target_dir" claude auth login; then
    materialize_profile_credentials "$target_dir" || true
    credentials_ready "$target_dir/.credentials.json" && login_ok=true
  fi
  if [[ "$login_ok" == true ]]; then
    chmod 600 "$target_dir/.credentials.json" 2>/dev/null || true
    [[ -f "$target_dir/.claude.json" ]] && chmod 600 "$target_dir/.claude.json" 2>/dev/null || true
    normalize_profile_identity "$new_name"
    # See add_new_profile: wire for shared sessions so `run` works right away.
    wire_profile_sharing "$new_name" "$( [[ "$pre_existed" == true ]] && printf 'true' || printf 'auto')" || true
    merge_profile_settings "$new_name" || true
    sync_profile_projects_key "$new_name" || true
    printf '\n%s%s%s\n' "$C_RULE" "────────────────────────────────────────" "$C_RESET"
    if [[ "$do_activate" == true ]]; then
      activate_profile "$new_name"
    else
      printf '%s·%s left the global account alone — switch with: %s%s activate %s%s\n' \
        "$C_MUTED" "$C_RESET" "$C_DIM" "$(basename "$0")" "$new_name" "$C_RESET"
    fi
    printf '%s✓%s Created profile %s%s%s.\n' \
      "$C_GREEN" "$C_RESET" "$C_BOLD" "$new_name" "$C_RESET"
    return 0
  fi

  [[ "$pre_existed" == false ]] && rm -rf "$target_dir"
  echo "Claude login did not complete; profile '$new_name' was not created." >&2
  return 1
}

# Put a set-aside credential back, or drop it. Called on every exit from
# cmd_relogin, including a signalled one: the file it moved aside is the only
# thing standing between a cancelled sign-in and an account you can no longer
# reach. A non-empty new credential wins — then the backup is just stale.
relogin_restore() {
  local creds="${1:-}"
  [[ -n "$creds" && -f "$creds.bak" ]] || return 0
  if [[ -s "$creds" ]]; then
    rm -f "$creds.bak"
  else
    mv "$creds.bak" "$creds" 2>/dev/null || true
  fi
}

# Sign in again into a profile that already exists. `refresh` renews a token from
# the stored refresh token; when THAT has lapsed too there is nothing left to
# renew, and a fresh browser login is the only way back. This is that command —
# and, unlike `add`, it keeps the profile: its wiring, its card style, its usage
# history and its name all survive, only the credential is replaced.
#
# The old credential is MOVED aside rather than overwritten in place, for two
# reasons. `claude auth login` then meets exactly the state a fresh `add` meets —
# a config dir with no credentials — which is the path known to work rather than
# one that might decide it is already signed in and return without doing
# anything. And the file's disappearance and reappearance is what the dashboard's
# job model watches to decide the sign-in landed, so one detector covers both
# commands. It is moved back on every failure path, signals included, so a
# cancelled attempt costs nothing.
cmd_relogin() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: $(basename "$0") relogin <profile>" >&2
    return 2
  fi
  local dir="$PROFILE_ROOT/$name"
  if [[ ! -d "$dir" ]]; then
    echo "Profile '$name' does not exist. Create it with: $(basename "$0") add $name" >&2
    return 1
  fi

  RELOGIN_CREDS="$dir/.credentials.json"
  local creds="$RELOGIN_CREDS"
  local was_active=false before_email
  [[ "$name" == "$(get_active_profile || true)" ]] && was_active=true
  before_email="$(profile_account_email "$name" || true)"

  # A backup from an attempt that was killed before it could put things back.
  # Restoring it here is what keeps a hard kill from costing the credential.
  relogin_restore "$creds"

  printf '\n%sSigning in again:%s %s%s%s\n\n' \
    "$C_MUTED" "$C_RESET" "$C_BOLD" "$name" "$C_RESET"
  echo "Complete the sign-in in your browser or terminal prompt."
  if [[ -n "$before_email" ]]; then
    echo "Use the same account ($before_email) — signing in as anyone else rebinds this profile."
  fi
  echo

  if [[ -f "$creds" ]] && ! mv "$creds" "$creds.bak" 2>/dev/null; then
    echo "Could not set '$name' credentials aside; nothing was changed." >&2
    return 1
  fi
  trap 'relogin_restore "$RELOGIN_CREDS"; exit 1' INT TERM HUP

  local login_ok=false
  if CLAUDE_CONFIG_DIR="$dir" claude auth login; then
    # See materialize_profile_credentials: on macOS the new token lands only in
    # the Keychain, and the file we moved aside is not it.
    materialize_profile_credentials "$dir" || true
    credentials_ready "$creds" && login_ok=true
  fi
  trap - INT TERM HUP
  relogin_restore "$creds"

  if [[ "$login_ok" != true ]]; then
    echo "Claude login did not complete; '$name' still has the credentials it had." >&2
    return 1
  fi

  chmod 600 "$creds" 2>/dev/null || true
  [[ -f "$dir/.claude.json" ]] && chmod 600 "$dir/.claude.json" 2>/dev/null || true
  normalize_profile_identity "$name"
  # 'false', not 'true': this can run from the dashboard, where there is no stdin
  # to answer a prompt with. An already-wired profile — which any profile old
  # enough to expire will be — has nothing to move and never asks anyway.
  wire_profile_sharing "$name" false || true
  merge_profile_settings "$name" || true
  sync_profile_projects_key "$name" || true

  local after_email; after_email="$(profile_account_email "$name" || true)"
  if [[ -n "$before_email" && -n "$after_email" && "$before_email" != "$after_email" ]]; then
    printf '%s⚠%s %s is now bound to %s (was %s).\n' \
      "$C_AMBER" "$C_RESET" "$name" "$after_email" "$before_email" >&2
  fi
  # Only when it was already the global account: a sign-in should not move the
  # global account, but leaving ~/.claude on the credential that just expired
  # would mean the profile is fixed and the shell it is live in still is not.
  if [[ "$was_active" == true ]]; then
    printf '\n%s%s%s\n' "$C_RULE" "────────────────────────────────────────" "$C_RESET"
    activate_profile "$name"
  fi
  printf '%s✓%s Signed in again as %s%s%s.\n' \
    "$C_GREEN" "$C_RESET" "$C_BOLD" "$name" "$C_RESET"
  return 0
}

# Resolve the absolute, symlink-followed path of THIS script. Portable across Linux
# and macOS (BSD `readlink` has no -f), so `claudius` can be a symlink on PATH while
# the dashboard sidecar is still found sitting next to the real script file.
resolve_script_path() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -h "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$src")"
}

# Launch the localhost dashboard sidecar. Hands off to Ruby entirely (exec), passing
# the profile root and this script's REAL path so the sidecar can shell mutations
# back in even when we were invoked through a PATH symlink (e.g. `claudius`).
cmd_serve() {
  local script_path script_dir dashboard
  script_path="$(resolve_script_path)"
  script_dir="$(dirname "$script_path")"
  dashboard="$script_dir/claude-dashboard.rb"
  # Fall back to the legacy $HOME location for pre-install layouts.
  [[ -f "$dashboard" ]] || dashboard="${HOME}/claude-dashboard.rb"
  if [[ ! -f "$dashboard" ]]; then
    echo "Dashboard not found next to $script_path (or in \$HOME)." >&2
    return 1
  fi
  require_webrick
  exec ruby "$dashboard" --root "$PROFILE_ROOT" --script "$script_path" "$@"
}

# Wire the team status line (statusline.sh next to this script) into Claude Code by
# stamping "statusLine" into the GLOBAL ~/.claude/settings.json and EVERY profile's
# settings.json (so parallel CLAUDE_CONFIG_DIR sessions get it too). Idempotent,
# backs up each file once. `--remove` undoes it (only if it points at our script,
# so a teammate who kept their own status line is never clobbered).
cmd_statusline() {
  local remove=false
  [[ "${1:-}" == "--remove" ]] && remove=true

  local script_dir sl cmd
  script_dir="$(dirname "$(resolve_script_path)")"
  sl="$script_dir/statusline.sh"
  [[ -f "$sl" ]] || sl="${HOME}/.claudius/statusline.sh"   # fallback to standard clone path
  if [[ "$remove" != true && ! -f "$sl" ]]; then
    echo "statusline.sh not found next to claudius ($script_dir)." >&2
    return 1
  fi
  cmd="bash $sl"

  # Targets: the global config plus every stored profile's own settings.json.
  local targets=("$CLAUDE_DIR/settings.json") n
  while IFS= read -r n; do
    [[ -n "$n" ]] && targets+=("$PROFILE_ROOT/$n/settings.json")
  done < <(list_profiles)

  local t
  for t in "${targets[@]}"; do
    ruby - "$t" "$cmd" "$remove" <<'RB'
require 'json'
path, cmd, remove = ARGV[0], ARGV[1], (ARGV[2] == "true")
dir = File.dirname(path)
exit 0 unless Dir.exist?(dir)            # skip config dirs that don't exist
data = File.exist?(path) ? (JSON.parse(File.read(path)) rescue {}) : {}
data = {} unless data.is_a?(Hash)
changed = false
if remove
  sl = data["statusLine"]
  if sl.is_a?(Hash) && sl["command"].to_s.include?("statusline.sh")
    data.delete("statusLine"); changed = true    # only remove OUR status line
  end
else
  want = {"type" => "command", "command" => cmd}
  unless data["statusLine"] == want
    File.write(path + ".bak", File.read(path)) if File.exist?(path) && !File.exist?(path + ".bak")
    data["statusLine"] = want
    changed = true
  end
end
if changed
  File.write(path, JSON.pretty_generate(data) + "\n")
  begin; File.chmod(0o600, path); rescue; end
  puts "  #{remove ? 'removed from' : 'set in'} #{path}"
else
  puts "  unchanged #{path}"
end
RB
  done

  if [[ "$remove" == true ]]; then
    printf '%s✓%s Removed the claudius status line.\n' "$C_GREEN" "$C_RESET"
  else
    printf '%s✓%s Status line enabled: %s%s%s\n' "$C_GREEN" "$C_RESET" "$C_DIM" "$cmd" "$C_RESET"
    printf '%s  Start a new session (or run /statusline) to see it.%s\n' "$C_MUTED" "$C_RESET"
  fi
}

cmd_help() {
  local prog; prog="$(basename "$0")"
  cat <<EOF
${C_TITLE}${prog}${C_RESET} — manage & monitor Claude accounts

${C_MUTED}USAGE${C_RESET}
  $prog                      launch the interactive TUI (default)
  $prog list [--json]        list profiles + cached usage (+ active flag)
  $prog status [--json]      show the active profile's live identity + usage
  $prog next [--explain]     print the account with the most room left
  $prog history [profile] [--json] [--points N]
                             usage over time: burn rate + when you hit a limit
  $prog sessions [--json] [--limit N]
                             list the shared session pool, newest first
  $prog refresh <profile>    renew token if needed & rewrite the usage cache
  $prog activate <profile>   switch the global ~/.claude to <profile>
  $prog run [profile] [args] open a session in <profile> without switching
                             the global account (no profile = pick one)
  $prog link <profile>       (re)wire a profile for shared sessions only
  $prog add [name] [--no-activate]
                             add a new profile (interactive browser login)
  $prog relogin <profile>    sign in again into a profile whose token cannot be
                             renewed any more (keeps the profile and its history)
  $prog remove <profile>     delete a stored profile (does not sign you out)
  $prog serve [--port N] [--open]
                             run the localhost dashboard (browser tab)
  $prog statusline [--remove] enable (or remove) the team status line in Claude Code
  $prog help | -h            show this help

${C_MUTED}RUN vs ACTIVATE${C_RESET}
  • 'activate' switches the ONE global account every 'claude' then uses.
  • 'run' leaves the global account alone and opens a session in that profile —
    so several accounts can be open at once. Any extra args go to 'claude':
      $prog run work --model sonnet
  • Run sessions SHARE your global ~/.claude: same conversation history (so
    -c/--resume see sessions from any account), same agents, commands, skills,
    prompt history and settings. Only the token + identity are per-profile.
  • macOS: the OAuth token lives in the login Keychain, and claude scopes that
    item per config dir, so 'run' gives a non-live profile its own credential
    and several accounts can be open at once here too. Needs claude
    $RUN_ISOLATION_MIN_VERSION or newer; below that 'run' refuses a non-live
    profile rather than opening the wrong account, so use 'activate' instead.

${C_MUTED}NOTES${C_RESET}
  • --json output is the stable contract consumed by the dashboard.
  • 'next' prints one name, so it composes:  $prog run "\$($prog next)"
    It exits 1 and says when the wait ends if every account is at a limit.
  • 'history' costs nothing: the status line records each reading it is
    handed, so the burn rate builds up for free while you work.
  • 'add' needs an interactive terminal (browser sign-in) — or the dashboard,
    which drives the same sign-in from the page. So does 'relogin'.
  • 'relogin' is what to reach for when 'refresh' says it cannot renew a token:
    the refresh token has lapsed too, so only a fresh sign-in gets the account
    back. Nothing else about the profile changes.
  • 'statusline' also warms the usage cache for free. Prefer your own status line?
    Keep just the cache bonus: node ~/.claudius/statusline-usage-cache.js | <yours>
EOF
}

main() {
  set -euo pipefail
  trap cleanup EXIT
  init_colors
  require_ruby
  require_claude
  ensure_storage
  migrate_profiles

  local sub="${1:-}"
  [[ $# -gt 0 ]] && shift || true
  case "$sub" in
    ""|menu)   show_menu; disable_raw_mode; leave_alt_screen ;;
    list)      cmd_list "$@" ;;
    sessions)  cmd_sessions "$@" ;;
    next)      cmd_next "$@" ;;
    history)   cmd_history "$@" ;;
    status)    cmd_status "$@" ;;
    refresh)   cmd_refresh "$@" ;;
    activate)  cmd_activate "$@" ;;
    run|open)  cmd_run "$@" ;;
    link)      cmd_link "$@" ;;
    add)       cmd_add "$@" ;;
    relogin)   cmd_relogin "$@" ;;
    remove|rm|delete) cmd_remove "$@" ;;
    serve)     cmd_serve "$@" ;;
    statusline) cmd_statusline "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
      echo "Unknown command: $sub" >&2
      echo "Run '$(basename "$0") help' for usage." >&2
      exit 2
      ;;
  esac
}

# Sourced-safe launcher. When executed as a program, run main directly. When
# *sourced*, run main inside a subshell so its `set -euo pipefail`, EXIT trap, and
# any `exit` stay contained and never terminate the caller's interactive shell.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  ( main "$@" )
else
  main "$@"
fi
